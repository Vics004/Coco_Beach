@model IEnumerable<persona>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout_Administrador.cshtml";
}

<div class="container-fluid">

    <!-- Cabecera de página -->
    <div class="cb-page-header">
        <div class="d-flex align-items-center">
            <i class="bi bi-people-fill cb-page-header-icon"></i>
            <div>
                <h2>@ViewData["Title"]</h2>
                <p>Administración de accesos y perfiles del sistema</p>
            </div>
        </div>
        <a asp-action="UsuarioCreate" class="cb-btn cb-btn-header">
            <i class="bi bi-plus-lg"></i> Nuevo Usuario
        </a>
    </div>
    <!-- Reemplaza tu <form method="get"> con esto -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" id="filtroSearch" class="cb-form-control"
                   placeholder="Buscar por nombre o correo..." />
        </div>
        <div class="col-md-3">
            <select id="filtroRol" class="cb-form-control">
                <option value="">-- Todos los roles --</option>
                @foreach (var rol in ViewBag.Roles)
                {
                    <option value="@rol.nombre">@rol.nombre</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select id="filtroEstado" class="cb-form-control">
                <option value="">-- Todos --</option>
                <option value="true">Activo</option>
                <option value="false">Inactivo</option>
            </select>
        </div>
        <div class="col-md-2">
            <a asp-action="UsuarioIndex" class="cb-btn cb-btn-outline w-100">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </div>
    <!-- Tabla de usuarios -->
    <div class="cb-card">
        <div class="cb-card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 style="font-family:var(--font-heading); font-weight:700; color:var(--cb-text-main); margin:0;">
                    Usuarios del Sistema
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table cb-table mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Teléfono</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span style="font-weight:600; color:var(--cb-text-main);">
                                        @item.nombre @item.apellido
                                    </span>
                                </td>
                                <td style="color:var(--cb-text-muted);">@item.correo</td>
                                <td>
                                    @if (item.rolid.HasValue)
                                    {
                                        <span class="cb-badge cb-badge-info">@item.rol?.nombre</span>
                                    }
                                    else
                                    {
                                        <span class="cb-badge cb-badge-muted">Sin rol</span>
                                    }
                                </td>
                                <td>
                                    <span class="cb-badge @(item.estado ? "cb-badge-success" : "cb-badge-danger")">
                                        @(item.estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td style="color:var(--cb-text-muted);">@item.telefono</td>
                                <td class="text-end">
                                    
									@if (item.estado)
									{
                                        <a asp-action="UsuarioDelete" asp-route-id="@item.personaid" class="cb-btn cb-btn-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
									}
                                    <a asp-action="UsuarioEdit" asp-route-id="@item.personaid" class="cb-btn cb-btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="cb-alert cb-alert-info mt-4">
                    <i class="bi bi-info-circle-fill"></i>
                    No hay usuarios registrados en el sistema todavía.
                </div>
            }

        </div>
    </div>

</div>

<style>
    .cb-btn-header {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
        padding: 0.6rem 1.2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        position: relative;
        z-index: 10;
    }

        .cb-btn-header:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.6);
            transform: translateY(-1px);
            color: #fff;
            text-decoration: none;
        }

        .cb-btn-header:active {
            transform: translateY(0);
        }

        .cb-btn-header i {
            pointer-events: none;
        }
</style>
<script>
    const todosLosUsuarios = @Html.Raw(ViewBag.UsuariosJson);
    const tbody = document.querySelector('.cb-table tbody');

    function renderUsuarios(lista) {
        if (lista.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6">
                        <div class="cb-alert cb-alert-info mt-2">
                            <i class="bi bi-info-circle-fill"></i>
                            No se encontraron usuarios.
                        </div>
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = lista.map(u => `
            <tr>
                <td><span style="font-weight:600; color:var(--cb-text-main);">${u.nombre} ${u.apellido}</span></td>
                <td style="color:var(--cb-text-muted);">${u.correo}</td>
                <td>
                    ${u.rolid
                        ? `<span class="cb-badge cb-badge-info">${u.rolNombre}</span>`
                        : `<span class="cb-badge cb-badge-muted">Sin rol</span>`}
                </td>
                <td>
                    <span class="cb-badge ${u.estado ? 'cb-badge-success' : 'cb-badge-danger'}">
                        ${u.estado ? 'Activo' : 'Inactivo'}
                    </span>
                </td>
                <td style="color:var(--cb-text-muted);">${u.telefono}</td>
                <td class="text-end">
                    <a href="/Admin/UsuarioEdit/${u.personaid}" class="cb-btn cb-btn-warning btn-sm me-1">
                        <i class="bi bi-pencil"></i>
                    </a>
                    <a href="/Admin/UsuarioDelete/${u.personaid}" class="cb-btn cb-btn-danger btn-sm">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
        `).join('');
    }

    function aplicarFiltros() {
        const q = document.getElementById('filtroSearch').value.toLowerCase().trim();
        const rol = document.getElementById('filtroRol').value;
        const estado = document.getElementById('filtroEstado').value;

        const filtrados = todosLosUsuarios.filter(u => {
            const nombreCompleto = `${u.nombre} ${u.apellido}`.toLowerCase();
            const correo = (u.correo ?? '').toLowerCase();

            const matchSearch = !q || nombreCompleto.includes(q) || correo.includes(q);
            const matchRol = !rol || u.rolNombre === rol;
            const matchEstado = estado === '' || String(u.estado) === estado;

            return matchSearch && matchRol && matchEstado;
        });

        renderUsuarios(filtrados);
    }

    document.getElementById('filtroSearch').addEventListener('input', aplicarFiltros);
    document.getElementById('filtroRol').addEventListener('change', aplicarFiltros);
    document.getElementById('filtroEstado').addEventListener('change', aplicarFiltros);
</script>