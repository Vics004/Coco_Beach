@model persona

@{
    ViewData["Title"] = "Crear Nuevo Usuario";
    Layout = "~/Views/Shared/_Layout_Administrador.cshtml";
}

<div class="container-fluid mt-4">

    <!-- Views/Shared/_AdminCardHeader.cshtml -->
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header text-white p-4"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-lock-fill me-3" style="font-size: 3.2rem; opacity: 0.9;"></i>
                    <div>
                        <h2 class="mb-1 fw-bold">@ViewData["Title"]</h2>
                        <p class="mb-0 text-white-75 small">Gestión de seguridad y accesos del sistema</p>
                    </div>
                </div>
                <a asp-controller="Login" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left-circle"></i> Volver al panel
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
                <input type="hidden" asp-for="estado" value="Activo" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="nombre" class="form-control" placeholder="Nombre" />
                            <label asp-for="nombre">Nombre</label>
                            <span asp-validation-for="nombre" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="apellido" class="form-control" placeholder="Apellido" />
                            <label asp-for="apellido">Apellido</label>
                            <span asp-validation-for="apellido" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="correo" class="form-control" type="email" placeholder="Correo" />
                            <label asp-for="correo">Correo</label>
                            <span asp-validation-for="correo" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Dropdown corregido -->
                    <div class="form-floating mb-3">
                        <select asp-for="rolid" class="form-select" asp-items="ViewBag.RolSelect">
                            <option value="">-- Seleccionar rol --</option>
                        </select>
                        <label asp-for="rolid">Rol</label>
                        <span asp-validation-for="rolid" class="text-danger"></span>
                    </div>
                    



                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="telefono" class="form-control" maxlength="9" placeholder="Teléfono" />
                            <label asp-for="telefono">Telefono</label>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-4">
                            <input type="password" name="password" class="form-control" required placeholder="Contraseña" />
                            <label>Contraseña</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-person-plus-fill me-2"></i> Crear Usuario
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}