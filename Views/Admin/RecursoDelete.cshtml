@model Coco_Beach.Models.recurso

@{
    ViewData["Title"] = "Deshabilitar Recurso";
    Layout = ViewBag.Layout ?? "~/Views/Shared/_Layout_Administrador.cshtml";
}

<div class="container-fluid">

    <!-- Cabecera de página (estilo advertencia) -->
    <div class="cb-page-header" style="background: linear-gradient(135deg, #D4881A 0%, #B56A10 100%);">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill cb-page-header-icon"></i>
            <div>
                <h2>@ViewData["Title"]</h2>
                <p>Esta acción deshabilitará el recurso, ya no estará disponible para nuevas reservas.</p>
            </div>
        </div>
        <a asp-action="RecursoIndex" class="cb-btn cb-btn-volver">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <!-- Card de confirmación -->
    <div class="cb-card" style="max-width: 560px;">
        <div class="cb-card-body">

            <div class="cb-alert cb-alert-warning mb-4" style="background: #FEF3C7; color: #B45309; border-left-color: #F59E0B;">
                <i class="bi bi-exclamation-triangle-fill" style="font-size:18px;"></i>
                <span>¿Estás seguro de que deseas deshabilitar este recurso? Podrás volver a habilitarlo más tarde.</span>
            </div>

            <!-- Datos del recurso -->
            <div style="background: var(--cb-bg); border-radius: 12px; padding: 20px; border: 1px solid var(--cb-border);">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div style="width:48px; height:48px; border-radius:50%; background:#FEF3C7; display:flex; align-items:center; justify-content:center; font-size:22px; color:#D97706;">
                        <i class="bi bi-door-closed-fill"></i>
                    </div>
                    <div>
                        <div style="font-family:var(--font-heading); font-weight:700; font-size:16px; color:var(--cb-text-main);">
                            @Model.nombre
                        </div>
                        <div style="font-size:13px; color:var(--cb-text-muted);">Capacidad: @Model.capacidad personas | Precio: $@Model.precio?.ToString("N0")</div>
                    </div>
                </div>
                <div style="font-size:13px; color:var(--cb-text-muted); border-top: 1px solid var(--cb-border); padding-top: 12px;">
                    <strong>Descripción:</strong> @Model.descripcion
                </div>
            </div>

            <!-- Acciones -->
            <form asp-action="RecursoDelete" method="post">
                <input type="hidden" asp-for="recursoid" />
                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="cb-btn" style="background-color: #D97706; color:#fff; border:none;">
                        <i class="bi bi-hand-thumbs-down-fill"></i> Sí, deshabilitar
                    </button>
                    <a asp-action="RecursoIndex" class="cb-btn cb-btn-outline">
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

<style>
    .cb-btn-volver {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
        padding: 0.6rem 1.2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        position: relative;
        z-index: 10;
    }

        .cb-btn-volver:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.6);
            transform: translateY(-1px);
            color: #fff;
            text-decoration: none;
        }

        .cb-btn-volver:active {
            transform: translateY(0);
        }

        .cb-btn-volver i {
            pointer-events: none;
        }
</style>