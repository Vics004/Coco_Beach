                        const ffInput = document.getElementById('editFechaFin');
                        if(ffInput) ffInput.min = formatDate(siguiente);
                        if (ffInput && ffInput.value && ffInput.value <= fi) {
                            ffInput.value = formatDate(siguiente);
                        }
                    }
                }
                const precioEdit = document.getElementById('editPrecio');
                if(precioEdit) delete precioEdit.dataset.editadoManual;
                calcularPrecioEditar();
            });
        }
    });

    const editPrecioInput = document.getElementById('editPrecio');
    if(editPrecioInput) {
        editPrecioInput.addEventListener('input', () => {
            editPrecioInput.dataset.editadoManual = 'true';
            actualizarBaseMiniCalc('miniCalcBaseEditar', parseFloat(editPrecioInput.value) || 0);
        });
    }

    const guardarEdicionBtn = document.getElementById('btnGuardarEdicion');
    if(guardarEdicionBtn) {
        guardarEdicionBtn.addEventListener('click', async () => {
            const clienteid = document.getElementById('editClienteId')?.value;
            if (!clienteid) { mostrarAlertaEditar('Debes seleccionar un huésped.'); return; }
            const fechaInicio = document.getElementById('editFechaInicio')?.value;
            const horaInicio = document.getElementById('editHoraInicio')?.value;
            const fechaFin = document.getElementById('editFechaFin')?.value;
            const horaSalida = document.getElementById('editHoraSalida')?.value;
            if (!fechaInicio || !fechaFin) { mostrarAlertaEditar('Las fechas son requeridas.'); return; }

            const dto = {
                reservaid: reservaidEditando,
                clienteid: parseInt(clienteid),
                recursoid: parseInt(document.getElementById('editRecursoid')?.value),
                estadoid: parseInt(document.getElementById('editEstadoid')?.value),
                fecha_inicio: `${fechaInicio}T${horaInicio}:00`,
                fecha_fin: `${fechaFin}T${horaSalida}:00`,
                preciofinal: parseFloat(document.getElementById('editPrecio')?.value) || null
            };

            const btn = document.getElementById('btnGuardarEdicion');
            if(btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...'; }

            try {
                const resp = await fetch('/Admin/EditarReservaCalendario', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dto) });
                if (resp.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('modalEditarReserva')).hide();
                    await cargarReservas();
                } else {
                    const err = await resp.json();
                    mostrarAlertaEditar(err.error ?? 'Error al guardar los cambios.');
                    if(btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> Guardar cambios'; }
                }
            } catch (e) {
                mostrarAlertaEditar('Error de conexión. Intenta de nuevo.');
                if(btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> Guardar cambios'; }
            }
        });
    }

    function mostrarAlertaEditar(msg) {
        const al = document.getElementById('editAlertaError');
        if(al) { al.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i>${msg}`; al.style.display = 'flex'; }
    }

    // Buscador de clientes en modal editar
    const editInputBuscar = document.getElementById('editInputBuscarCliente');
    if(editInputBuscar) {
        editInputBuscar.addEventListener('input', (e) => {
            clearTimeout(editSearchTimeout);
            const q = e.target.value.trim();
            if (q.length < 2) { const dd = document.getElementById('editClienteDropdown'); if(dd) dd.style.display = 'none'; return; }
            editSearchTimeout = setTimeout(() => editBuscarClientes(q), 280);
        });
    }

    async function editBuscarClientes(q) {
        const resp = await fetch(`/Admin/BuscarClientes?q=${encodeURIComponent(q)}`);
        const clientes = await resp.json();
        editRenderDropdown(clientes, q);
    }

    function editRenderDropdown(clientes, q) {
        const dd = document.getElementById('editClienteDropdown');
        if(!dd) return;
        dd.innerHTML = '';
        clientes.forEach(c => {
            const item = document.createElement('div');
            item.className = 'cliente-option';
            item.innerHTML = `<div class="opt-nombre">${c.nombre ?? ''} ${c.apellido ?? ''}</div>
                              <div class="opt-meta">${[c.correo, c.telefono].filter(Boolean).join(' · ')}</div>`;
            item.addEventListener('click', () => editSeleccionarCliente(c));
            dd.appendChild(item);
        });
        const crearBtn = document.createElement('div');
        crearBtn.className = 'cliente-option-crear';
        crearBtn.innerHTML = `<i class="bi bi-person-plus-fill"></i> Crear "${q}" como nuevo cliente`;
        crearBtn.addEventListener('click', () => {
            const nombreInput = document.getElementById('editNuevoNombre');
            const apellidoInput = document.getElementById('editNuevoApellido');
            if(nombreInput) nombreInput.value = q.split(' ')[0] ?? q;
            if(apellidoInput) apellidoInput.value = q.split(' ').slice(1).join(' ');
            if(dd) dd.style.display = 'none';
            const seccion = document.getElementById('editSeccionCrearCliente');
            if(seccion) seccion.style.display = 'block';
        });
        dd.appendChild(crearBtn);
        dd.style.display = 'block';
    }

    function editSeleccionarCliente(c) {
        editClienteSeleccionado = c;
        const clienteIdInput = document.getElementById('editClienteId');
        if(clienteIdInput) clienteIdInput.value = c.personaid;
        const selectedDiv = document.getElementById('editClienteSelected');
        const selectedSpan = document.getElementById('editClienteSelectedNombre');
        if(selectedSpan) selectedSpan.textContent = `${c.nombre ?? ''} ${c.apellido ?? ''}`.trim();
        if(selectedDiv) selectedDiv.style.display = 'flex';
        const inputBuscar = document.getElementById('editInputBuscarCliente');
        if(inputBuscar) inputBuscar.style.display = 'none';
        const dropdown = document.getElementById('editClienteDropdown');
        if(dropdown) dropdown.style.display = 'none';
        const seccionCrear = document.getElementById('editSeccionCrearCliente');
        if(seccionCrear) seccionCrear.style.display = 'none';
    }

    function editLimpiarClienteSeleccionado() {
        editClienteSeleccionado = null;
        const clienteIdInput = document.getElementById('editClienteId');
        if(clienteIdInput) clienteIdInput.value = '';
        const selectedDiv = document.getElementById('editClienteSelected');
        if(selectedDiv) selectedDiv.style.display = 'none';
        const inputBuscar = document.getElementById('editInputBuscarCliente');
        if(inputBuscar) { inputBuscar.style.display = 'block'; inputBuscar.value = ''; }
        const dropdown = document.getElementById('editClienteDropdown');
        if(dropdown) dropdown.style.display = 'none';
        const seccionCrear = document.getElementById('editSeccionCrearCliente');
        if(seccionCrear) seccionCrear.style.display = 'none';
    }

    const editClearBtn = document.getElementById('btnEditClearCliente');
    if(editClearBtn) editClearBtn.addEventListener('click', editLimpiarClienteSeleccionado);
    const editCerrarCrear = document.getElementById('btnEditCerrarCrearCliente');
    if(editCerrarCrear) { editCerrarCrear.addEventListener('click', () => { const s = document.getElementById('editSeccionCrearCliente'); if(s) s.style.display = 'none'; }); }

    const editCodigoPais = document.getElementById('editNuevoCodigoPais');
    if(editCodigoPais) {
        editCodigoPais.addEventListener('change', function () {
            const help = document.getElementById('editNuevoTelefonoHelp');
            const digitos = digitosRequeridosCliente[this.value];
            const numeroInput = document.getElementById('editNuevoNumeroTelefono');
            if(numeroInput) numeroInput.value = '';
            if (help) {
                if (digitos) { help.textContent = `Requiere exactamente ${digitos} dígitos`; help.style.color = 'var(--cb-primary)'; }
                else { help.textContent = 'Selecciona un código de país'; help.style.color = 'var(--cb-text-muted)'; }
            }
            editLimpiarErrorCampo('editErrTelefono');
        });
    }

    const editNumeroTelefono = document.getElementById('editNuevoNumeroTelefono');
    if(editNumeroTelefono) { editNumeroTelefono.addEventListener('input', function () { this.value = this.value.replace(/\D/g, ''); editLimpiarErrorCampo('editErrTelefono'); }); }

    function editMostrarErrorCampo(id, msg) { const el = document.getElementById(id); if(el) { el.textContent = msg; el.style.display = 'block'; } }
    function editLimpiarErrorCampo(id) { const el = document.getElementById(id); if(el) { el.textContent = ''; el.style.display = 'none'; } }
    function editLimpiarTodosLosErrores() { ['editErrNombre','editErrApellido','editErrCorreo','editErrTelefono'].forEach(editLimpiarErrorCampo); }

    const editNombreEl = document.getElementById('editNuevoNombre');
    if(editNombreEl) editNombreEl.addEventListener('input', () => editLimpiarErrorCampo('editErrNombre'));
    const editApellidoEl = document.getElementById('editNuevoApellido');
    if(editApellidoEl) editApellidoEl.addEventListener('input', () => editLimpiarErrorCampo('editErrApellido'));
    const editCorreoEl = document.getElementById('editNuevoCorreo');
    if(editCorreoEl) editCorreoEl.addEventListener('input', () => editLimpiarErrorCampo('editErrCorreo'));
    if(editNumeroTelefono) editNumeroTelefono.addEventListener('input', () => editLimpiarErrorCampo('editErrTelefono'));

    function editValidarNuevoCliente() {
        let valido = true;
        editLimpiarTodosLosErrores();
        const nombre = document.getElementById('editNuevoNombre')?.value.trim() || '';
        const apellido = document.getElementById('editNuevoApellido')?.value.trim() || '';
        const correo = document.getElementById('editNuevoCorreo')?.value.trim() || '';
        const codigo = document.getElementById('editNuevoCodigoPais')?.value || '';
        const numero = document.getElementById('editNuevoNumeroTelefono')?.value.trim() || '';

        if (!nombre) { editMostrarErrorCampo('editErrNombre', 'El nombre es requerido.'); valido = false; }
        else if (nombre.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombre)) { editMostrarErrorCampo('editErrNombre', 'Solo letras, mínimo 2 caracteres.'); valido = false; }
        if (!apellido) { editMostrarErrorCampo('editErrApellido', 'El apellido es requerido.'); valido = false; }
        else if (apellido.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellido)) { editMostrarErrorCampo('editErrApellido', 'Solo letras, mínimo 2 caracteres.'); valido = false; }
        if (!correo) { editMostrarErrorCampo('editErrCorreo', 'El correo es requerido.'); valido = false; }
        else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(correo)) { editMostrarErrorCampo('editErrCorreo', 'Ingresa un correo válido.'); valido = false; }
        if (!codigo) { editMostrarErrorCampo('editErrTelefono', 'Selecciona un código de país.'); valido = false; }
        else if (!numero) { editMostrarErrorCampo('editErrTelefono', 'El número de teléfono es requerido.'); valido = false; }
        else {
            const digitosNecesarios = digitosRequeridosCliente[codigo];
            if (!digitosNecesarios) { editMostrarErrorCampo('editErrTelefono', 'Código de país no reconocido.'); valido = false; }
            else if (numero.length !== digitosNecesarios) { editMostrarErrorCampo('editErrTelefono', `El número debe tener exactamente ${digitosNecesarios} dígitos para ${codigo}. Tienes ${numero.length}.`); valido = false; }
        }
        return valido;
    }

    const editGuardarClienteBtn = document.getElementById('btnEditGuardarNuevoCliente');
    if(editGuardarClienteBtn) {
        editGuardarClienteBtn.addEventListener('click', async () => {
            if (!editValidarNuevoCliente()) return;
            const codigo = document.getElementById('editNuevoCodigoPais')?.value || '';
            const numero = document.getElementById('editNuevoNumeroTelefono')?.value.trim() || '';
            const dto = {
                nombre: document.getElementById('editNuevoNombre')?.value.trim() || '',
                apellido: document.getElementById('editNuevoApellido')?.value.trim() || '',
                correo: document.getElementById('editNuevoCorreo')?.value.trim() || '',
                telefono: `${codigo}|${numero}`
            };
            const btn = document.getElementById('btnEditGuardarNuevoCliente');
            if(btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...'; }
            try {
                const resp = await fetch('/Admin/CrearClienteRapido', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dto) });
                if (resp.ok) {
                    const nuevo = await resp.json();
                    editSeleccionarCliente(nuevo);
                    editLimpiarTodosLosErrores();
                    ['editNuevoNombre','editNuevoApellido','editNuevoCorreo','editNuevoNumeroTelefono'].forEach(id => { const el = document.getElementById(id); if(el) el.value = ''; });
                    const codigoSelect = document.getElementById('editNuevoCodigoPais');
                    if(codigoSelect) codigoSelect.value = '';
                    const help = document.getElementById('editNuevoTelefonoHelp');
                    if(help) help.textContent = 'Selecciona un código de país';
                } else {
                    const err = await resp.json();
                    alert(err.error ?? 'Error al crear el cliente.');
                }
            } catch (e) { alert('Error de conexión.'); }
            finally { if(btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg"></i> Guardar cliente y continuar'; } }
        });
    }

    // =========================================
    // ✅ MINI CALCULADORA — INICIO
    // =========================================
    function initMiniCalcs() {
        configurarMiniCalc('miniCalcBaseCrear', 'miniCalcPanelCrear', 'miniCalcOpCrear', 'miniCalcValCrear', 'btnMiniCalcApplyCrear', 'btnMiniCalcCrear', 'modalPrecio');
        configurarMiniCalc('miniCalcBaseEditar', 'miniCalcPanelEditar', 'miniCalcOpEditar', 'miniCalcValEditar', 'btnMiniCalcApplyEditar', 'btnMiniCalcEditar', 'editPrecio');
    }

    function configurarMiniCalc(baseId, panelId, opId, valId, applyId, toggleId, precioInputId) {
        const toggleBtn = document.getElementById(toggleId);
        const panel = document.getElementById(panelId);
        const applyBtn = document.getElementById(applyId);
        const precioInput = document.getElementById(precioInputId);

        if (!toggleBtn || !panel) return;

        toggleBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = panel.style.display !== 'none';
            // Cerrar otros paneles
            document.querySelectorAll('.mini-calc-panel').forEach(p => p.style.display = 'none');
            if (!isOpen) {
                // Actualizar base con precio actual
                const base = parseFloat(precioInput?.value) || 0;
                const baseEl = document.getElementById(baseId);
                if (baseEl) baseEl.textContent = `$${base.toFixed(2)}`;
                // Limpiar valor de operación
                const valInput = document.getElementById(valId);
                if (valInput) valInput.value = '';
                panel.style.display = 'flex';
            }
        });

        if (applyBtn) {
            applyBtn.addEventListener('click', () => {
                const base = parseFloat(precioInput?.value) || 0;
                const op = document.getElementById(opId)?.value || '+';
                const val = parseFloat(document.getElementById(valId)?.value) || 0;
                let resultado = base;

                switch (op) {
                    case '+': resultado = base + val; break;
                    case '-': resultado = base - val; break;
                    case '*': resultado = base * val; break;
                    case '/': resultado = val !== 0 ? base / val : base; break;
                }

                if (resultado < 0) resultado = 0;
                resultado = Math.round(resultado * 100) / 100;

                if (precioInput) {
                    precioInput.value = resultado.toFixed(2);
                    precioInput.dataset.editadoManual = 'true';
                    actualizarBaseMiniCalc(baseId, resultado);
                }
                // Limpiar valor pero mantener panel abierto para más operaciones
                const valInput = document.getElementById(valId);
                if (valInput) valInput.value = '';
            });
        }

        // Cerrar panel al hacer click fuera
        document.addEventListener('click', (e) => {
            if (!panel.contains(e.target) && e.target !== toggleBtn) {
                panel.style.display = 'none';
            }
        });

        // Aplicar con Enter
        const valInput = document.getElementById(valId);
        if (valInput) {
            valInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); applyBtn?.click(); }
            });
        }
    }

    function actualizarBaseMiniCalc(baseId, valor) {
        const baseEl = document.getElementById(baseId);
        if (baseEl) baseEl.textContent = `$${Number(valor).toFixed(2)}`;
    }

    // =========================================
    // BUSCADOR GLOBAL (filtrar píldoras)
    // =========================================
    const buscadorHuesped = document.getElementById('buscadorHuesped');
    if(buscadorHuesped) {
        buscadorHuesped.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase().trim();
            if (!q) {
                renderPildoras(todasLasReservas);
                return;
            }
            const filtradas = todasLasReservas.filter(r => {
                const nombre = `${r.cliente?.nombre ?? ''} ${r.cliente?.apellido ?? ''}`.toLowerCase();
                const correo = (r.cliente?.correo ?? '').toLowerCase();
                return nombre.includes(q) || correo.includes(q);
            });
            renderPildoras(filtradas);
            document.querySelectorAll('.cal-pill').forEach(p => p.classList.add('resaltada'));
        });
    }

    // =========================================
    // NAVEGACIÓN DE MES
    // =========================================
    const btnMesAnt = document.getElementById('btnMesAnterior');
    if(btnMesAnt) {
        btnMesAnt.addEventListener('click', () => {
            mesActual.setMonth(mesActual.getMonth() - 1);
            renderCalendario();
            cargarReservas();
        });
    }

    const btnMesSig = document.getElementById('btnMesSiguiente');
    if(btnMesSig) {
        btnMesSig.addEventListener('click', () => {
            mesActual.setMonth(mesActual.getMonth() + 1);
            renderCalendario();
            cargarReservas();
        });
    }

    const btnHoy = document.getElementById('btnHoy');
    if(btnHoy) {
        btnHoy.addEventListener('click', () => {
            mesActual = new Date();
            mesActual.setDate(1);
            renderCalendario();
            cargarReservas();
            setTimeout(() => {
                const hoy = new Date();
                const wrap = document.getElementById('timelineWrap');
                const diaHoy = hoy.getDate();
                if(wrap) wrap.scrollLeft = (diaHoy - 3) * 44;
            }, 100);
        });
    }

    // =========================================
    // ✅ EXPORTAR ICS (funcional)
    // =========================================
         // recursoidICS = null significa exportar todo, número = habitación específica
    let recursoidICS = null;

    function exportarICS() {
        recursoidICS = null;
        abrirModalICS();
    }

    function abrirModalICS() {
        // Fechas por defecto: hoy + 1 mes
        const hoy = formatDate(new Date());
        const unMes = new Date();
        unMes.setMonth(unMes.getMonth() + 1);
        const unMesStr = formatDate(unMes);

        document.getElementById('icsDesde').value = hoy;
        document.getElementById('icsHasta').value = unMesStr;
        document.getElementById('icsAlertaError').style.display = 'none';

        new bootstrap.Modal(document.getElementById('modalExportarICS')).show();
    }

        function setRangoICS(dias, direccion) {
        const hoy = new Date();
        const base = new Date();
        const otra = new Date();
        otra.setDate(otra.getDate() + (direccion === 'pasado' ? -dias : dias));

        if (direccion === 'pasado') {
            document.getElementById('icsDesde').value = formatDate(otra);
            // solo sobreescribir "hasta" si está vacío o es anterior a "otra"
            const hastaActual = document.getElementById('icsHasta').value;
            if (!hastaActual || hastaActual < formatDate(otra)) {
                document.getElementById('icsHasta').value = formatDate(hoy);
            }
        } else {
            // solo sobreescribir "desde" si está vacío o es posterior a "otra"
            const desdeActual = document.getElementById('icsDesde').value;
            if (!desdeActual || desdeActual > formatDate(otra)) {
                document.getElementById('icsDesde').value = formatDate(hoy);
            }
            document.getElementById('icsHasta').value = formatDate(otra);
        }
    }

    document.getElementById('btnConfirmarExportarICS')?.addEventListener('click', () => {
        const desde = document.getElementById('icsDesde').value;
        const hasta = document.getElementById('icsHasta').value;
        const alerta = document.getElementById('icsAlertaError');

        if (!desde || !hasta) {
            alerta.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i>Selecciona ambas fechas.';
            alerta.style.display = 'flex';
            return;
        }
        if (desde > hasta) {
            alerta.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-2"></i>La fecha de inicio debe ser anterior a la fecha de fin.';
            alerta.style.display = 'flex';
            return;
        }

        bootstrap.Modal.getInstance(document.getElementById('modalExportarICS')).hide();

        if (recursoidICS) {
            window.location.href = `/Admin/ExportarICS?recursoid=${recursoidICS}&desde=${desde}&hasta=${hasta}`;
        } else {
            window.location.href = `/Admin/ExportarICSCompleto?tipo=${TIPO_CAL}&desde=${desde}&hasta=${hasta}`;
        }
    });

    function bindEventos() {
        // Los eventos ya están enlazados individualmente con optional chaining
    }

    function formatDate(d) {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }
</script>

