        const clienteIdInput = document.getElementById('editClienteId');
        if(clienteIdInput) clienteIdInput.value = '';
        const selectedDiv = document.getElementById('editClienteSelected');
        if(selectedDiv) selectedDiv.style.display = 'none';
        const inputBuscar = document.getElementById('editInputBuscarCliente');
        if(inputBuscar) {
            inputBuscar.style.display = 'block';
            inputBuscar.value = '';
        }
        const dropdown = document.getElementById('editClienteDropdown');
        if(dropdown) dropdown.style.display = 'none';
        const seccionCrear = document.getElementById('editSeccionCrearCliente');
        if(seccionCrear) seccionCrear.style.display = 'none';
    }

    const editClearBtn = document.getElementById('btnEditClearCliente');
    if(editClearBtn) editClearBtn.addEventListener('click', editLimpiarClienteSeleccionado);
    const editCerrarCrear = document.getElementById('btnEditCerrarCrearCliente');
    if(editCerrarCrear) {
        editCerrarCrear.addEventListener('click', () => {
            const seccion = document.getElementById('editSeccionCrearCliente');
            if(seccion) seccion.style.display = 'none';
        });
    }

    // Validación de nuevo cliente en editar (simplificada, igual que la de crear)
    const editCodigoPais = document.getElementById('editNuevoCodigoPais');
    if(editCodigoPais) {
        editCodigoPais.addEventListener('change', function () {
            const help = document.getElementById('editNuevoTelefonoHelp');
            const digitos = digitosRequeridosCliente[this.value];
            const numeroInput = document.getElementById('editNuevoNumeroTelefono');
            if(numeroInput) numeroInput.value = '';
            if (help) {
                if (digitos) {
                    help.textContent = `Requiere exactamente ${digitos} dígitos`;
                    help.style.color = 'var(--cb-primary)';
                } else {
                    help.textContent = 'Selecciona un código de país';
                    help.style.color = 'var(--cb-text-muted)';
                }
            }
            editLimpiarErrorCampo('editErrTelefono');
        });
    }

    const editNumeroTelefono = document.getElementById('editNuevoNumeroTelefono');
    if(editNumeroTelefono) {
        editNumeroTelefono.addEventListener('input', function () {
            this.value = this.value.replace(/\D/g, '');
            editLimpiarErrorCampo('editErrTelefono');
        });
    }

    function editMostrarErrorCampo(id, msg) {
        const el = document.getElementById(id);
        if(el) {
            el.textContent = msg;
            el.style.display = 'block';
        }
    }
    function editLimpiarErrorCampo(id) {
        const el = document.getElementById(id);
        if(el) {
            el.textContent = '';
            el.style.display = 'none';
        }
    }
    function editLimpiarTodosLosErrores() {
        ['editErrNombre','editErrApellido','editErrCorreo','editErrTelefono'].forEach(editLimpiarErrorCampo);
    }

    const editNombre = document.getElementById('editNuevoNombre');
    if(editNombre) editNombre.addEventListener('input', () => editLimpiarErrorCampo('editErrNombre'));
    const editApellido = document.getElementById('editNuevoApellido');
    if(editApellido) editApellido.addEventListener('input', () => editLimpiarErrorCampo('editErrApellido'));
    const editCorreo = document.getElementById('editNuevoCorreo');
    if(editCorreo) editCorreo.addEventListener('input', () => editLimpiarErrorCampo('editErrCorreo'));
    if(editNumeroTelefono) editNumeroTelefono.addEventListener('input', () => editLimpiarErrorCampo('editErrTelefono'));

    function editValidarNuevoCliente() {
        let valido = true;
        editLimpiarTodosLosErrores();
        const nombre = document.getElementById('editNuevoNombre')?.value.trim() || '';
        const apellido = document.getElementById('editNuevoApellido')?.value.trim() || '';
        const correo = document.getElementById('editNuevoCorreo')?.value.trim() || '';
        const codigo = document.getElementById('editNuevoCodigoPais')?.value || '';
        const numero = document.getElementById('editNuevoNumeroTelefono')?.value.trim() || '';

        if (!nombre) {
            editMostrarErrorCampo('editErrNombre', 'El nombre es requerido.');
            valido = false;
        } else if (nombre.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombre)) {
            editMostrarErrorCampo('editErrNombre', 'Solo letras, mínimo 2 caracteres.');
            valido = false;
        }
        if (!apellido) {
            editMostrarErrorCampo('editErrApellido', 'El apellido es requerido.');
            valido = false;
        } else if (apellido.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellido)) {
            editMostrarErrorCampo('editErrApellido', 'Solo letras, mínimo 2 caracteres.');
            valido = false;
        }
        if (!correo) {
            editMostrarErrorCampo('editErrCorreo', 'El correo es requerido.');
            valido = false;
        } else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(correo)) {
            editMostrarErrorCampo('editErrCorreo', 'Ingresa un correo válido.');
            valido = false;
        }
        if (!codigo) {
            editMostrarErrorCampo('editErrTelefono', 'Selecciona un código de país.');
            valido = false;
        } else if (!numero) {
            editMostrarErrorCampo('editErrTelefono', 'El número de teléfono es requerido.');
            valido = false;
        } else {
            const digitosNecesarios = digitosRequeridosCliente[codigo];
            if (!digitosNecesarios) {
                editMostrarErrorCampo('editErrTelefono', 'Código de país no reconocido.');
                valido = false;
            } else if (numero.length !== digitosNecesarios) {
                editMostrarErrorCampo('editErrTelefono', `El número debe tener exactamente ${digitosNecesarios} dígitos para ${codigo}. Tienes ${numero.length}.`);
                valido = false;
            }
        }
        return valido;
    }

    const editGuardarClienteBtn = document.getElementById('btnEditGuardarNuevoCliente');
    if(editGuardarClienteBtn) {
        editGuardarClienteBtn.addEventListener('click', async () => {
            if (!editValidarNuevoCliente()) return;
            const codigo = document.getElementById('editNuevoCodigoPais')?.value || '';
            const numero = document.getElementById('editNuevoNumeroTelefono')?.value.trim() || '';
            const dto = {
                nombre: document.getElementById('editNuevoNombre')?.value.trim() || '',
                apellido: document.getElementById('editNuevoApellido')?.value.trim() || '',
                correo: document.getElementById('editNuevoCorreo')?.value.trim() || '',
                telefono: `${codigo}|${numero}`
            };
            const btn = document.getElementById('btnEditGuardarNuevoCliente');
            if(btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
            }
            try {
                const resp = await fetch('/Admin/CrearClienteRapido', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(dto)
                });
                if (resp.ok) {
                    const nuevo = await resp.json();
                    editSeleccionarCliente(nuevo);
                    editLimpiarTodosLosErrores();
                    ['editNuevoNombre','editNuevoApellido','editNuevoCorreo','editNuevoNumeroTelefono'].forEach(id => {
                        const el = document.getElementById(id);
                        if(el) el.value = '';
                    });
                    const codigoSelect = document.getElementById('editNuevoCodigoPais');
                    if(codigoSelect) codigoSelect.value = '';
                    const help = document.getElementById('editNuevoTelefonoHelp');
                    if(help) help.textContent = 'Selecciona un código de país';
                } else {
                    const err = await resp.json();
                    alert(err.error ?? 'Error al crear el cliente.');
                }
            } catch (e) {
                alert('Error de conexión.');
            } finally {
                if(btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> Guardar cliente y continuar';
                }
            }
        });
    }

    // =========================================
    // BUSCADOR GLOBAL (filtrar píldoras)
    // =========================================
    const buscadorHuesped = document.getElementById('buscadorHuesped');
    if(buscadorHuesped) {
        buscadorHuesped.addEventListener('input', (e) => {
            const q = e.target.value.toLowerCase().trim();
            if (!q) {
                renderPildoras(todasLasReservas);
                return;
            }
            const filtradas = todasLasReservas.filter(r => {
                const nombre = `${r.cliente?.nombre ?? ''} ${r.cliente?.apellido ?? ''}`.toLowerCase();
                const correo = (r.cliente?.correo ?? '').toLowerCase();
                return nombre.includes(q) || correo.includes(q);
            });
            renderPildoras(filtradas);
            document.querySelectorAll('.cal-pill').forEach(p => p.classList.add('resaltada'));
        });
    }

    // =========================================
    // NAVEGACIÓN DE MES (con optional chaining para evitar errores)
    // =========================================
    const btnMesAnt = document.getElementById('btnMesAnterior');
    if(btnMesAnt) {
        btnMesAnt.addEventListener('click', () => {
            mesActual.setMonth(mesActual.getMonth() - 1);
            renderCalendario();
            cargarReservas();
        });
    }

    const btnMesSig = document.getElementById('btnMesSiguiente');
    if(btnMesSig) {
        btnMesSig.addEventListener('click', () => {
            mesActual.setMonth(mesActual.getMonth() + 1);
            renderCalendario();
            cargarReservas();
        });
    }

    const btnHoy = document.getElementById('btnHoy');
    if(btnHoy) {
        btnHoy.addEventListener('click', () => {
            mesActual = new Date();
            mesActual.setDate(1);
            renderCalendario();
            cargarReservas();
            setTimeout(() => {
                const hoy = new Date();
                const wrap = document.getElementById('timelineWrap');
                const diaHoy = hoy.getDate();
                if(wrap) wrap.scrollLeft = (diaHoy - 3) * 44;
            }, 100);
        });
    }

    // =========================================
    // EXPORTAR ICS
    // =========================================
    function exportarICS() {
        if (RECURSOS.length === 1) {
            window.location.href = `/Admin/ExportarICS/${RECURSOS[0].recursoid}`;
        } else {
            const recursoid = RECURSOS[0]?.recursoid;
            if (recursoid) window.location.href = `/Admin/ExportarICS/${recursoid}`;
        }
    }

    function bindEventos() {
        // Ya todos los eventos están asignados de forma segura con condicionales
    }

    function formatDate(d) {
        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}