    // =========================================
    // MODAL CREAR RESERVA
    // =========================================
    function getPrecioRecurso(recursoid) {
        const r = RECURSOS.find(r => r.recursoid === parseInt(recursoid));
        return r?.precio ?? 0;
    }

    function calcularPrecio() {
        const fi = document.getElementById('modalFechaInicio')?.value;
        const ff = document.getElementById('modalFechaFin')?.value;
        const recursoid = document.getElementById('modalRecursoid')?.value;
        const infoEl = document.getElementById('modalPrecioInfo');
        const infoTexto = document.getElementById('modalPrecioInfoTexto');
        const precioInput = document.getElementById('modalPrecio');

        if (!fi || !ff || !recursoid) { if(infoEl) infoEl.style.display = 'none'; return; }

        const inicio = new Date(fi);
        const fin = new Date(ff);
        const dias = Math.round((fin - inicio) / (1000 * 60 * 60 * 24));

        if (dias <= 0) { if(infoEl) infoEl.style.display = 'none'; return; }

        const precioPorNoche = getPrecioRecurso(recursoid);
        const total = dias * precioPorNoche;

        if(infoTexto) infoTexto.textContent = `${dias} ${dias === 1 ? 'día' : 'días'} × $${precioPorNoche.toFixed(2)}/noche = $${total.toFixed(2)}`;
        if(infoEl) infoEl.style.display = 'flex';

        if (precioInput && !precioInput.dataset.editadoManual) {
            precioInput.value = total.toFixed(2);
            actualizarBaseMiniCalc('miniCalcBaseCrear', total);
        }
    }

    function actualizarOpcionesHabitacion(fechaStr) {
        const select = document.getElementById('modalRecursoid');
        if (!select) return;
        const valorActual = select.value;

        select.innerHTML = '';

        RECURSOS.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.recursoid;

            // ✅ Bloquear recursos deshabilitados en el select
            if (recursosDeshabilitadosIds.has(r.recursoid)) {
                opt.textContent = `${r.nombre} — No habilitada`;
                opt.style.color = '#999';
                opt.disabled = true;
                opt.className = 'opt-bloqueada';
            } else {
                const tieneCheckin = todasLasReservas.some(res =>
                    res.recursoid === r.recursoid &&
                    res.estadoid !== 3 && res.estadoid !== 4 &&
                    formatDate(new Date(res.fecha_inicio)) === fechaStr
                );

                const fecha = new Date(fechaStr + 'T00:00:00');
                const disp = calcularDisponibilidadCelda(r.recursoid, fecha);
                const esBloqueada = disp === 'bloqueado';

                if (tieneCheckin || esBloqueada) {
                    opt.textContent = `${r.nombre} — Ocupada`;
                    opt.style.color = '#999';
                    opt.disabled = true;
                    opt.className = 'opt-bloqueada';
                } else {
                    opt.textContent = r.nombre;
                }
            }

            select.appendChild(opt);
        });

        if (valorActual) {
            const existe = Array.from(select.options).some(o => o.value === valorActual && !o.disabled);
            if (existe) select.value = valorActual;
        }

        validarDisponibilidadModal();
    }

    function validarDisponibilidadModal() {
        const recursoid = parseInt(document.getElementById('modalRecursoid')?.value);
        const fechaIni = document.getElementById('modalFechaInicio')?.value;
        const fechaFin = document.getElementById('modalFechaFin')?.value;
        const alerta = document.getElementById('alertaError');
        const btnGuardar = document.getElementById('btnGuardarReserva');

        if (!fechaIni || !fechaFin || !recursoid) return;

        // ✅ No se puede reservar en recurso deshabilitado
        if (recursosDeshabilitadosIds.has(recursoid)) {
            if(alerta) alerta.innerHTML = `<i class="bi bi-slash-circle-fill me-2"></i>Esta habitación no está habilitada.`;
            if(alerta) alerta.style.display = 'flex';
            if(btnGuardar) btnGuardar.disabled = true;
            return;
        }

        const iniDate = new Date(fechaIni + 'T00:00:00');
        const finDate = new Date(fechaFin + 'T00:00:00');

        const reservasConflicto = todasLasReservas.filter(r => {
            if (r.recursoid !== recursoid) return false;
            if (r.estadoid === 3 || r.estadoid === 4) return false;
            const rIni = new Date(r.fecha_inicio);
            const rFin = new Date(r.fecha_fin);
            const rIniStr = formatDate(rIni);
            const rFinStr = formatDate(rFin);
            const iniStr = formatDate(iniDate);
            const finStr = formatDate(finDate);
            return !(finStr <= rIniStr || iniStr >= rFinStr);
        });

        if (reservasConflicto.length > 0) {
            const res = reservasConflicto[0];
            const nombre = res.cliente ? `${res.cliente.nombre ?? ''} ${res.cliente.apellido ?? ''}`.trim() : `Reserva #${res.reservaid}`;
            const fi = new Date(res.fecha_inicio).toLocaleDateString('es-SV');
            const ff = new Date(res.fecha_fin).toLocaleDateString('es-SV');
            if(alerta) alerta.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i>Esta habitación ya tiene una reserva (${nombre}, ${fi} → ${ff}). Elige otras fechas u otra habitación.`;
            if(alerta) alerta.style.display = 'flex';
            if(btnGuardar) btnGuardar.disabled = true;
        } else {
            if(alerta) alerta.style.display = 'none';
            if(btnGuardar) btnGuardar.disabled = false;
        }
    }

    function abrirModalCrear(recursoid, fecha) {
        // ✅ No abrir si el recurso está deshabilitado
        if (recursosDeshabilitadosIds.has(recursoid)) return;

        const fechaInicioInput = document.getElementById('modalFechaInicio');
        if(fechaInicioInput) fechaInicioInput.value = fecha;

        const siguiente = new Date(fecha + 'T00:00:00');
        siguiente.setDate(siguiente.getDate() + 1);
        const siguienteStr = formatDate(siguiente);
        const fechaFinInput = document.getElementById('modalFechaFin');
        if(fechaFinInput) {
            fechaFinInput.value = siguienteStr;
            fechaFinInput.min = siguienteStr;
        }
        if(fechaInicioInput) fechaInicioInput.min = fecha;

        const precioInput = document.getElementById('modalPrecio');
        if(precioInput) {
            delete precioInput.dataset.editadoManual;
            precioInput.value = '';
        }

        actualizarOpcionesHabitacion(fecha);
        const recursoSelect = document.getElementById('modalRecursoid');
        if(recursoSelect) recursoSelect.value = recursoid;

        calcularPrecio();
        limpiarClienteSeleccionado();
        const alerta = document.getElementById('alertaError');
        if(alerta) alerta.style.display = 'none';
        const btnGuardar = document.getElementById('btnGuardarReserva');
        if(btnGuardar) btnGuardar.disabled = false;

        // Ocultar panel mini-calc
        const panel = document.getElementById('miniCalcPanelCrear');
        if (panel) panel.style.display = 'none';

        const modal = new bootstrap.Modal(document.getElementById('modalCrearReserva'));
        modal.show();
