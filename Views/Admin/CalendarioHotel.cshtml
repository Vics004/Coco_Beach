    function abrirModalEditar(r) {
        reservaidEditando = r.reservaid;

        const editRecurso = document.getElementById('editRecursoid');
        if(editRecurso) editRecurso.value = r.recursoid;
        const editEstado = document.getElementById('editEstadoid');
        if(editEstado) editEstado.value = r.estadoid;

        const fiStr = r.fecha_inicio;
        const ffStr = r.fecha_fin;
