        if(editFechaInicio) editFechaInicio.value = fiStr.substring(0, 10);
        if(editFechaFin) editFechaFin.value = ffStr.substring(0, 10);
        if(editHoraInicio) editHoraInicio.value = fiStr.substring(11, 16);
        if(editHoraSalida) editHoraSalida.value = ffStr.substring(11, 16);

        const precioInput = document.getElementById('editPrecio');
        if(precioInput) {
            precioInput.value = r.preciofinal != null ? Number(r.preciofinal).toFixed(2) : '';
            delete precioInput.dataset.editadoManual;
        }
        calcularPrecioEditar();

        if (r.cliente) {
