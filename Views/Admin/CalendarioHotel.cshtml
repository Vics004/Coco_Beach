    if(numeroTelefonoInput) numeroTelefonoInput.addEventListener('input', () => limpiarErrorCampo('errTelefono'));

    function validarNuevoCliente() {
        let valido = true;
        limpiarTodosLosErrores();
        const nombre = document.getElementById('nuevoNombre')?.value.trim() || '';
        const apellido = document.getElementById('nuevoApellido')?.value.trim() || '';
        const correo = document.getElementById('nuevoCorreo')?.value.trim() || '';
        const codigo = document.getElementById('nuevoCodigoPais')?.value || '';
        const numero = document.getElementById('nuevoNumeroTelefono')?.value.trim() || '';

        if (!nombre) { mostrarErrorCampo('errNombre', 'El nombre es requerido.'); valido = false; }
        else if (nombre.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(nombre)) { mostrarErrorCampo('errNombre', 'Solo letras, mínimo 2 caracteres.'); valido = false; }

        if (!apellido) { mostrarErrorCampo('errApellido', 'El apellido es requerido.'); valido = false; }
        else if (apellido.length < 2 || !/^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/.test(apellido)) { mostrarErrorCampo('errApellido', 'Solo letras, mínimo 2 caracteres.'); valido = false; }

        if (!correo) { mostrarErrorCampo('errCorreo', 'El correo es requerido.'); valido = false; }
        else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]{2,}$/.test(correo)) { mostrarErrorCampo('errCorreo', 'Ingresa un correo válido.'); valido = false; }

        if (!codigo) { mostrarErrorCampo('errTelefono', 'Selecciona un código de país.'); valido = false; }
        else if (!numero) { mostrarErrorCampo('errTelefono', 'El número de teléfono es requerido.'); valido = false; }
        else {
            const digitosNecesarios = digitosRequeridosCliente[codigo];
            if (!digitosNecesarios) { mostrarErrorCampo('errTelefono', 'Código de país no reconocido.'); valido = false; }
            else if (numero.length !== digitosNecesarios) { mostrarErrorCampo('errTelefono', `El número debe tener exactamente ${digitosNecesarios} dígitos para ${codigo}. Tienes ${numero.length}.`); valido = false; }
        }
        return valido;
    }

