    // RENDER PRINCIPAL
    // =========================================
    function renderCalendario() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const hoy = new Date();

        document.getElementById('mesLabel').textContent =
            `${MESES[mes]} ${año}`;

        // --- Header de días ---
        const diasHeader = document.getElementById('diasHeader');
        diasHeader.innerHTML = '';
        for (let d = 1; d <= diasEnMes; d++) {
            const fecha = new Date(año, mes, d);
            const esFinde = fecha.getDay() === 0 || fecha.getDay() === 6;
            const esHoy = fecha.toDateString() === hoy.toDateString();
            const cell = document.createElement('div');
            cell.className = 'cal-day-header-cell' +
                (esFinde ? ' weekend' : '') +
                (esHoy ? ' today' : '');
            cell.innerHTML = `<span class="day-num">${d}</span>
                              <span class="day-name">${DIAS_CORTO[fecha.getDay()]}</span>`;
            diasHeader.appendChild(cell);
        }

        // --- Grid de filas ---
        const grid = document.getElementById('calGrid');
        grid.innerHTML = '';

        // Ancho total = dias * dayWidth
        const totalW = diasEnMes * 44;
        grid.style.width = totalW + 'px';

        // Línea de hoy
        if (hoy.getFullYear() === año && hoy.getMonth() === mes) {
            const todayLine = document.createElement('div');
            todayLine.className = 'cal-today-line';
            todayLine.style.left = ((hoy.getDate() - 1) * 44 + 22) + 'px';
            grid.appendChild(todayLine);
        }

        RECURSOS.forEach(recurso => {
            const row = document.createElement('div');
            row.className = 'cal-grid-row';
            row.dataset.recursoid = recurso.recursoid;

            for (let d = 1; d <= diasEnMes; d++) {
                const fecha = new Date(año, mes, d);
                const esFinde = fecha.getDay() === 0 || fecha.getDay() === 6;
                const esHoy = fecha.toDateString() === hoy.toDateString();
                const esPasado = fecha < new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());

                // Calcular disponibilidad de esta celda
                const disp = calcularDisponibilidadCelda(recurso.recursoid, fecha);

                const cell = document.createElement('div');
                let clases = 'cal-grid-cell';
                if (esFinde)               clases += ' weekend';
                if (esHoy)                 clases += ' today-col';
                if (esPasado)              clases += ' cell-pasado';
                else if (disp === 'bloqueado')  clases += ' cell-bloqueada';
                else if (disp === 'checkout')   clases += ' cell-checkout';
                cell.className = clases;
                cell.dataset.fecha = formatDate(fecha);
                cell.dataset.recursoid = recurso.recursoid;
                cell.dataset.disp = disp;

                if (esPasado) {
                    cell.title = 'No se pueden crear reservas en fechas pasadas';
                } else if (disp === 'bloqueado') {
                    cell.title = 'Habitación ocupada este día';
                } else {
                    // Libre o checkout: se puede reservar
                    const addBtn = document.createElement('div');
                    addBtn.className = 'cell-add-btn';
                    addBtn.innerHTML = '+';
                    cell.appendChild(addBtn);

                    if (disp === 'checkout') {
                        const tag = document.createElement('div');
                        tag.className = 'cell-checkout-tag';
                        tag.title = 'Salida hoy — disponible desde las 3pm';
                        tag.innerHTML = '<i class="bi bi-arrow-right-circle-fill"></i>';
                        cell.appendChild(tag);
                    }

                    cell.addEventListener('click', () => {
                        abrirModalCrear(recurso.recursoid, formatDate(fecha));
                    });
                }

                row.appendChild(cell);
            }

            grid.appendChild(row);
        });

        // Sincronizar scroll vertical entre recursos y grid
        sincronizarScroll();
    }

    // =========================================
    // FIX: Sincronización bidireccional de scroll
    // =========================================
    function sincronizarScroll() {
        const wrap = document.getElementById('timelineWrap');
        const recursos = document.getElementById('colRecursos');

        let syncingFromWrap = false;
        let syncingFromRecursos = false;

        wrap.addEventListener('scroll', () => {
            if (syncingFromWrap) return;
            syncingFromRecursos = true;
            recursos.scrollTop = wrap.scrollTop;
            syncingFromRecursos = false;
        });

        recursos.addEventListener('scroll', () => {
            if (syncingFromRecursos) return;
            syncingFromWrap = true;
            wrap.scrollTop = recursos.scrollTop;
            syncingFromWrap = false;
        });
    }

    // =========================================
    // DISPONIBILIDAD POR CELDA
    // =========================================
    function calcularDisponibilidadCelda(recursoid, fecha) {
        const reservasRecurso = todasLasReservas.filter(r =>
            r.recursoid === recursoid && r.estadoid !== 3
        );

        const fechaStr = formatDate(fecha);

        let esBloqueado = false;
        let esCheckout = false;

        for (const r of reservasRecurso) {
            const ini = new Date(r.fecha_inicio);
            const fin = new Date(r.fecha_fin);

            const iniStr = formatDate(ini);
            const finStr = formatDate(fin);

            if (fechaStr === finStr) {
                esCheckout = true;
                continue;
            }

            if (fechaStr > iniStr && fechaStr < finStr) {
                esBloqueado = true;
                break;
            }

            if (fechaStr === iniStr) {
                esBloqueado = true;
                break;
            }
        }

        if (esBloqueado) return 'bloqueado';
        if (esCheckout)  return 'checkout';
        return 'libre';
    }

    function aplicarDisponibilidadEnGrid() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();

        RECURSOS.forEach(recurso => {
            for (let d = 1; d <= diasEnMes; d++) {
                const fecha = new Date(año, mes, d);
                const fechaStr = formatDate(fecha);
                const cell = document.querySelector(
                    `.cal-grid-row[data-recursoid="${recurso.recursoid}"] .cal-grid-cell[data-fecha="${fechaStr}"]`
                );
                if (!cell) continue;

                const hoyMidnight = new Date();
                hoyMidnight.setHours(0, 0, 0, 0);
                const esPasado = fecha < hoyMidnight;

                const disp = calcularDisponibilidadCelda(recurso.recursoid, fecha);
                cell.dataset.disp = disp;

                cell.classList.remove('cell-bloqueada', 'cell-checkout', 'cell-pasado');

                const viejoAddBtn = cell.querySelector('.cell-add-btn');
                const viejoTag = cell.querySelector('.cell-checkout-tag');
                if (viejoAddBtn) viejoAddBtn.remove();
                if (viejoTag) viejoTag.remove();

                const nuevoCell = cell.cloneNode(false);
                nuevoCell.dataset.fecha = fechaStr;
                nuevoCell.dataset.recursoid = recurso.recursoid;
                nuevoCell.dataset.disp = disp;

                if (esPasado) {
                    nuevoCell.classList.add('cell-pasado');
                    nuevoCell.title = 'No se pueden crear reservas en fechas pasadas';
                } else if (disp === 'bloqueado') {
                    nuevoCell.classList.add('cell-bloqueada');
                    nuevoCell.title = 'Habitación ocupada este día';
                } else {
                    const addBtn = document.createElement('div');
                    addBtn.className = 'cell-add-btn';
                    addBtn.innerHTML = '+';
                    nuevoCell.appendChild(addBtn);

                    if (disp === 'checkout') {
                        nuevoCell.classList.add('cell-checkout');
                        const tag = document.createElement('div');
                        tag.className = 'cell-checkout-tag';
                        tag.title = 'Salida hoy — disponible desde las 3pm';
                        tag.innerHTML = '<i class="bi bi-arrow-right-circle-fill"></i>';
                        nuevoCell.appendChild(tag);
                    }

                    nuevoCell.addEventListener('click', () => {
                        abrirModalCrear(recurso.recursoid, fechaStr);
                    });
                }

                cell.replaceWith(nuevoCell);
            }
        });
    }

    // =========================================
    // CARGAR RESERVAS (AJAX)
    // =========================================
    async function cargarReservas() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const inicio = formatDate(new Date(año, mes, 1));
        const fin = formatDate(new Date(año, mes, diasEnMes));

        try {
            const resp = await fetch(`/Admin/GetReservas?fechaInicio=${inicio}&fechaFin=${fin}&tipo=${TIPO_CAL}`);
            todasLasReservas = await resp.json();

            const ahora = new Date();
            const vencidas = todasLasReservas.filter(r => {
                if (r.estadoid === 3) return false;
                if (!r.fecha_fin) return false;
                const fin = new Date(r.fecha_fin);
                const checkout = new Date(fin);
                checkout.setHours(13, 0, 0, 0);
                return ahora >= checkout;
            });

            if (vencidas.length > 0) {
                vencidas.forEach(r => {
                    r.estadoid = 3;
                    fetch('/Admin/CambiarEstadoReserva', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reservaid: r.reservaid, estadoid: 3 })
                    }).catch(() => {});
                });
            }

            reservasFiltradas = todasLasReservas;
            renderPildoras(todasLasReservas);
            aplicarDisponibilidadEnGrid();
        } catch (e) {
            console.error('Error cargando reservas:', e);
        }
    }

    // =========================================
    // RENDER PÍLDORAS
    // =========================================
    function renderPildoras(reservas) {
        document.querySelectorAll('.cal-pill').forEach(p => p.remove());

        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const primero = new Date(año, mes, 1);
        const ultimo = new Date(año, mes, diasEnMes, 23, 59, 59);

        const rowSlots = {};

        reservas.forEach(r => {
            const row = document.querySelector(`.cal-grid-row[data-recursoid="${r.recursoid}"]`);
            if (!row) return;

            let inicio = new Date(r.fecha_inicio);
            let fin = new Date(r.fecha_fin);

            const iniVis = inicio < primero ? primero : inicio;
            const finVis = fin > ultimo ? ultimo : fin;

            const diaIni = iniVis.getDate();
            const diaFin = finVis.getDate();
            const duracion = diaFin - diaIni + 1;

            if (duracion <= 0) return;

            if (!rowSlots[r.recursoid]) rowSlots[r.recursoid] = [];
            const slots = rowSlots[r.recursoid];

            let carril = 0;
            let encontrado = false;
            while (!encontrado) {
                const ocupado = slots.some(s => s.carril === carril && s.diaIni <= diaFin && s.diaFin >= diaIni);
                if (!ocupado) {
                    encontrado = true;
                } else {
                    carril++;
                }
            }
            slots.push({ diaIni, diaFin, carril });

            const pillH = 28;
            const pillGap = 4;
            const rowH = 64;
            const totalCarriles = Math.max(...slots.map(s => s.carril)) + 1;
            const totalAltoPills = totalCarriles * pillH + (totalCarriles - 1) * pillGap;
            const offsetBase = (rowH - totalAltoPills) / 2;
            const topPx = offsetBase + carril * (pillH + pillGap);

            const pill = document.createElement('div');
            const estadoClass = [1,2].includes(r.estadoid) ? `estado-${r.estadoid}` : 'estado-otro';
            pill.className = `cal-pill ${estadoClass}`;
            pill.style.left = ((diaIni - 1) * 44 + 3) + 'px';
            pill.style.width = (duracion * 44 - 6) + 'px';
            pill.style.top = topPx + 'px';
            pill.style.transform = 'none';
            pill.style.height = pillH + 'px';

            const nombre = r.cliente ? `${r.cliente.nombre ?? ''} ${r.cliente.apellido ?? ''}`.trim() : `Reserva #${r.reservaid}`;
            pill.innerHTML = `<span class="cal-pill-text">${nombre}</span>`;
            pill.dataset.reservaid = r.reservaid;

            pill.addEventListener('click', (e) => {
                e.stopPropagation();
                mostrarPopover(r, pill);
            });

            row.appendChild(pill);
        });
    }

    // =========================================
    // POPOVER
    // =========================================
    let reservaActualEnPopover = null;

    function mostrarPopover(r, pillEl) {
        reservaActualEnPopover = r;
        const popover = document.getElementById('calPopover');
        const nombre = r.cliente ? `${r.cliente.nombre ?? ''} ${r.cliente.apellido ?? ''}`.trim() : '—';

        document.getElementById('popHuesped').textContent = nombre || '—';
        document.getElementById('popTelefono').textContent = r.cliente?.telefono || '—';
        document.getElementById('popCorreo').textContent = r.cliente?.correo || '—';

        const fi = new Date(r.fecha_inicio).toLocaleDateString('es-SV');
        const ff = new Date(r.fecha_fin).toLocaleDateString('es-SV');
        document.getElementById('popFechas').textContent = `${fi} → ${ff}`;
        document.getElementById('popPrecio').textContent = r.preciofinal != null ? `$${Number(r.preciofinal).toFixed(2)}` : '—';

        const estados = {1:'Reservado', 2:'En proceso de reserva', 3:'Disponible'};
        const badge = document.getElementById('popEstadoBadge');
        const coloresBadge = {
            1: 'background:var(--cb-primary-pale);color:var(--cb-primary-dark)',
            2: 'background:#FFF4E0;color:#A36B00',
            3: 'background:#E3F9F3;color:#1A8C6E'
        };
        badge.style.cssText = coloresBadge[r.estadoid] ?? 'background:#EEF2F4;color:#5A7280';
        badge.textContent = estados[r.estadoid] ?? '—';

        document.querySelectorAll('.pop-estado-btn').forEach(btn => {
            const bid = parseInt(btn.dataset.estadoid);
            btn.classList.toggle('activo', bid === r.estadoid);
        });

        const fb = document.getElementById('popEstadoFeedback');
        fb.style.display = 'none';
        fb.textContent = '';

        document.getElementById('popLinkExportar').href = `/Admin/ExportarICS/${r.recursoid}`;

        popover.style.display = 'block';
        const rect = pillEl.getBoundingClientRect();
        let top = rect.bottom + 8;
        let left = rect.left;

        const pw = 280;
        if (left + pw > window.innerWidth - 16) left = window.innerWidth - pw - 16;
        if (top + 300 > window.innerHeight) top = rect.top - 310;

        popover.style.top = top + 'px';
        popover.style.left = left + 'px';
    }

    document.querySelectorAll('.pop-estado-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            if (!reservaActualEnPopover) return;
            const nuevoEstado = parseInt(btn.dataset.estadoid);
            if (nuevoEstado === reservaActualEnPopover.estadoid) return;

            btn.disabled = true;
            const fb = document.getElementById('popEstadoFeedback');

            try {
                const resp = await fetch('/Admin/CambiarEstadoReserva', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reservaid: reservaActualEnPopover.reservaid, estadoid: nuevoEstado })
                });

                if (resp.ok) {
                    reservaActualEnPopover.estadoid = nuevoEstado;
                    const estados = {1:'Reservado', 2:'En proceso de reserva', 3:'Disponible'};
                    const coloresBadge = {
                        1: 'background:var(--cb-primary-pale);color:var(--cb-primary-dark)',
                        2: 'background:#FFF4E0;color:#A36B00',
                        3: 'background:#E3F9F3;color:#1A8C6E'
                    };
                    const badge = document.getElementById('popEstadoBadge');
                    badge.style.cssText = coloresBadge[nuevoEstado] ?? '';
                    badge.textContent = estados[nuevoEstado];
                    document.querySelectorAll('.pop-estado-btn').forEach(b => {
                        b.classList.toggle('activo', parseInt(b.dataset.estadoid) === nuevoEstado);
                    });
                    fb.innerHTML = `<i class="bi bi-check-circle-fill"></i> Estado actualizado`;
                    fb.style.display = 'flex';
                    setTimeout(() => { fb.style.display = 'none'; }, 2500);
                    await cargarReservas();
                } else {
                    const err = await resp.json();
                    fb.innerHTML = `<i class="bi bi-exclamation-triangle-fill" style="color:var(--cb-danger)"></i> <span style="color:var(--cb-danger)">${err.error ?? 'Error'}</span>`;
                    fb.style.display = 'flex';
                }
            } catch (e) {
                fb.innerHTML = `<i class="bi bi-exclamation-triangle-fill" style="color:var(--cb-danger)"></i> <span style="color:var(--cb-danger)">Error de conexión</span>`;
                fb.style.display = 'flex';
            } finally {
                btn.disabled = false;
            }
        });
    });

    document.getElementById('btnCerrarPopover')?.addEventListener('click', () => {
        document.getElementById('calPopover').style.display = 'none';
    });

    document.addEventListener('click', (e) => {
        const popover = document.getElementById('calPopover');
        if (!popover.contains(e.target) && !e.target.classList.contains('cal-pill')) {
            popover.style.display = 'none';
        }
    });

    // =========================================
    // MODAL CREAR RESERVA
    // =========================================
    function getPrecioRecurso(recursoid) {
        const r = RECURSOS.find(r => r.recursoid === parseInt(recursoid));
        return r?.precio ?? 0;
    }

    function calcularPrecio() {
        const fi = document.getElementById('modalFechaInicio')?.value;
        const ff = document.getElementById('modalFechaFin')?.value;
        const recursoid = document.getElementById('modalRecursoid')?.value;
        const infoEl = document.getElementById('modalPrecioInfo');
        const infoTexto = document.getElementById('modalPrecioInfoTexto');
        const precioInput = document.getElementById('modalPrecio');

        if (!fi || !ff || !recursoid) { if(infoEl) infoEl.style.display = 'none'; return; }

        const inicio = new Date(fi);
        const fin = new Date(ff);
        const dias = Math.round((fin - inicio) / (1000 * 60 * 60 * 24));

        if (dias <= 0) { if(infoEl) infoEl.style.display = 'none'; return; }

        const precioPorNoche = getPrecioRecurso(recursoid);
        const total = dias * precioPorNoche;

        if(infoTexto) infoTexto.textContent = `${dias} ${dias === 1 ? 'día' : 'días'} × $${precioPorNoche.toFixed(2)}/noche = $${total.toFixed(2)}`;
        if(infoEl) infoEl.style.display = 'flex';

        if (precioInput && !precioInput.dataset.editadoManual) {
            precioInput.value = total.toFixed(2);
        }
    }

    function actualizarOpcionesHabitacion(fechaStr) {
        const select = document.getElementById('modalRecursoid');
        if (!select) return;
        const valorActual = select.value;

        select.innerHTML = '';

        RECURSOS.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.recursoid;

            const tieneCheckin = todasLasReservas.some(res =>
                res.recursoid === r.recursoid &&
                res.estadoid !== 3 &&
                formatDate(new Date(res.fecha_inicio)) === fechaStr
            );

            const fecha = new Date(fechaStr + 'T00:00:00');
            const disp = calcularDisponibilidadCelda(r.recursoid, fecha);
            const esBloqueada = disp === 'bloqueado';

            if (tieneCheckin || esBloqueada) {
                opt.textContent = `${r.nombre} — Ocupada`;
                opt.style.color = '#999';
                opt.disabled = true;
                opt.className = 'opt-bloqueada';
            } else {
                opt.textContent = r.nombre;
            }

            select.appendChild(opt);
        });

        if (valorActual) {
            const existe = Array.from(select.options).some(o => o.value === valorActual);
            if (existe) select.value = valorActual;
        }

        validarDisponibilidadModal();
    }

    function validarDisponibilidadModal() {
        const recursoid = parseInt(document.getElementById('modalRecursoid')?.value);
        const fechaIni = document.getElementById('modalFechaInicio')?.value;
        const fechaFin = document.getElementById('modalFechaFin')?.value;
        const alerta = document.getElementById('alertaError');
        const btnGuardar = document.getElementById('btnGuardarReserva');

        if (!fechaIni || !fechaFin || !recursoid) return;

        const iniDate = new Date(fechaIni + 'T00:00:00');
        const finDate = new Date(fechaFin + 'T00:00:00');

        const reservasConflicto = todasLasReservas.filter(r => {
            if (r.recursoid !== recursoid) return false;
            if (r.estadoid === 3) return false;
            const rIni = new Date(r.fecha_inicio);
            const rFin = new Date(r.fecha_fin);
            const rIniStr = formatDate(rIni);
            const rFinStr = formatDate(rFin);
            const iniStr = formatDate(iniDate);
            const finStr = formatDate(finDate);
            return !(finStr <= rIniStr || iniStr >= rFinStr);
        });

        if (reservasConflicto.length > 0) {
            const res = reservasConflicto[0];
            const nombre = res.cliente ? `${res.cliente.nombre ?? ''} ${res.cliente.apellido ?? ''}`.trim() : `Reserva #${res.reservaid}`;
            const fi = new Date(res.fecha_inicio).toLocaleDateString('es-SV');
            const ff = new Date(res.fecha_fin).toLocaleDateString('es-SV');
            if(alerta) alerta.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-2"></i>Esta habitación ya tiene una reserva (${nombre}, ${fi} → ${ff}). Elige otras fechas u otra habitación.`;
            if(alerta) alerta.style.display = 'flex';
            if(btnGuardar) btnGuardar.disabled = true;
        } else {
            if(alerta) alerta.style.display = 'none';
            if(btnGuardar) btnGuardar.disabled = false;
        }
    }

    function abrirModalCrear(recursoid, fecha) {
        const fechaInicioInput = document.getElementById('modalFechaInicio');
        if(fechaInicioInput) fechaInicioInput.value = fecha;

        const siguiente = new Date(fecha + 'T00:00:00');
        siguiente.setDate(siguiente.getDate() + 1);
        const siguienteStr = formatDate(siguiente);
        const fechaFinInput = document.getElementById('modalFechaFin');
        if(fechaFinInput) {
            fechaFinInput.value = siguienteStr;
            fechaFinInput.min = siguienteStr;
        }
        if(fechaInicioInput) fechaInicioInput.min = fecha;

        const precioInput = document.getElementById('modalPrecio');
        if(precioInput) delete precioInput.dataset.editadoManual;

        actualizarOpcionesHabitacion(fecha);
        const recursoSelect = document.getElementById('modalRecursoid');
        if(recursoSelect) recursoSelect.value = recursoid;

        calcularPrecio();
        limpiarClienteSeleccionado();
        const alerta = document.getElementById('alertaError');
        if(alerta) alerta.style.display = 'none';
        const btnGuardar = document.getElementById('btnGuardarReserva');
        if(btnGuardar) btnGuardar.disabled = false;

        const modal = new bootstrap.Modal(document.getElementById('modalCrearReserva'));
        modal.show();
    }

    ['modalFechaInicio', 'modalFechaFin', 'modalRecursoid'].forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('change', () => {
                if (id === 'modalFechaInicio') {
                    const fi = document.getElementById('modalFechaInicio')?.value;
                    if (fi) {
                        const siguiente = new Date(fi + 'T00:00:00');
                        siguiente.setDate(siguiente.getDate() + 1);
                        const ffInput = document.getElementById('modalFechaFin');
                        if(ffInput) ffInput.min = formatDate(siguiente);
                        if (ffInput && ffInput.value && ffInput.value <= fi) {
                            ffInput.value = formatDate(siguiente);
                        }
                        actualizarOpcionesHabitacion(fi);
                    }
                }
                const precioInput = document.getElementById('modalPrecio');
                if(precioInput) delete precioInput.dataset.editadoManual;
                calcularPrecio();
                validarDisponibilidadModal();
            });
        }
    });

    const precioInput = document.getElementById('modalPrecio');
    if(precioInput) {
        precioInput.addEventListener('input', () => {
            precioInput.dataset.editadoManual = 'true';
        });
    }

