@model IEnumerable<Coco_Beach.Models.recurso>
@{
    var esRancho = Model.Any() && Model.First().recursoid == 15;
    var titulo = esRancho ? "Calendario — Rancho" : "Calendario — Hotel";
    var subtitulo = esRancho ? "Disponibilidad del Rancho" : "Disponibilidad de habitaciones";
    var tipoCalendario = esRancho ? "rancho" : "hotel";
    var gradienteHeader = esRancho
        ? "linear-gradient(135deg, #2ECC9A 0%, #1A8C6E 100%)"
        : "linear-gradient(135deg, #29B6D2 0%, #1A6FA8 100%)";

    ViewData["Title"] = titulo;
    Layout = ViewBag.Layout ?? "~/Views/Shared/_Layout_Administrador.cshtml";
}

<link rel="stylesheet" href="~/css/cocobeach.css" />

<div class="container-fluid px-0">

    <!-- HEADER -->
    <div class="cb-page-header" style="background: @gradienteHeader; margin-bottom: 0; border-radius: 0;">
        <div class="d-flex align-items-center gap-3">
            @if (esRancho)
            {
                <img src="~/images/logo4 rancho.png"
                     alt="Rancho"
                     style="height: 100px; width: auto; object-fit: contain; filter: brightness(0) invert(1); flex-shrink: 0; margin: -26px 0;" />
            }
            else
            {
                <img src="~/images/logo1 cocobeach texto completo.png"
                     alt="CocoBeach"
                     style="height: 100px; width: auto; object-fit: contain; filter: brightness(0) invert(1); flex-shrink: 0; margin: -24px 0;" />
            }
            <div>
                <h2 class="mb-0">@titulo</h2>
                <p class="mb-0 d-none d-sm-block">@subtitulo</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="#" class="cb-btn cb-btn-volver d-none d-md-flex" onclick="exportarICS()" title="Exportar calendario .ics">
                <i class="bi bi-download"></i> <span class="d-none d-lg-inline">Exportar</span> .ics
            </a>
            <button class="cb-btn" id="btnAgregarReserva"
                    style="background:rgba(255,255,255,0.22); color:#fff; border:1.5px solid rgba(255,255,255,0.45); font-weight:700;">
                <i class="bi bi-plus-lg"></i> <span class="d-none d-sm-inline">Agregar reserva</span>
            </button>
        </div>
    </div>

    <!-- BARRA DE NAVEGACIÓN DEL CALENDARIO -->
    <div class="cal-nav-bar">
        <div class="cal-nav-left">
            <button class="cal-nav-btn" id="btnMesAnterior" title="Mes anterior">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="cal-nav-btn" id="btnMesSiguiente" title="Mes siguiente">
                <i class="bi bi-chevron-right"></i>
            </button>
            <span class="cal-mes-label" id="mesLabel">Cargando...</span>
            <button class="cal-nav-btn-today" id="btnHoy">Hoy</button>
        </div>
        <div class="cal-nav-right">
            <div class="cal-search-wrap">
                <i class="bi bi-search cal-search-icon"></i>
                <input type="text" class="cal-search-input" id="buscadorHuesped"
                       placeholder="Buscar huésped..." autocomplete="off" />
            </div>
            <!-- Botón .ics en móvil -->
            <a href="#" class="cal-nav-btn d-md-none" onclick="exportarICS()" title="Exportar .ics" style="font-size:14px;">
                <i class="bi bi-download"></i>
            </a>
        </div>
    </div>

    <!-- LEYENDA -->
    <div class="cal-leyenda">
        <span class="leyenda-item">
            <span class="leyenda-dot" style="background:var(--cal-reservado);"></span>
            Reservado
        </span>
        <span class="leyenda-item">
            <span class="leyenda-dot" style="background:var(--cal-proceso); opacity:0.7;"></span>
            En proceso
        </span>
        <span class="leyenda-item">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:12px;height:12px;border-radius:3px;background:repeating-linear-gradient(45deg,transparent,transparent 3px,rgba(180,180,200,0.4) 3px,rgba(180,180,200,0.4) 6px);border:1px solid #ccc;"></span>
            No disponible
        </span>
        <span class="leyenda-item">
            <i class="bi bi-arrow-right-circle-fill" style="color:var(--cb-success);font-size:12px;"></i>
            Salida hoy
        </span>
        <!-- ✅ Nueva entrada de leyenda: No habilitado -->
        <span class="leyenda-item">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:12px;height:12px;border-radius:3px;background:#f0e6f6;border:1px solid #b39ddb;"></span>
            No habilitado
        </span>
    </div>

    <!-- CUERPO DEL CALENDARIO -->
    <div class="cal-wrapper">
        <!-- Columna de recursos (habitaciones) -->
        <div class="cal-resources-col" id="colRecursos">
            <div class="cal-resources-header">Habitación</div>
            @foreach (var r in Model)
            {
                <div class="cal-resource-row @(r.libre == false ? "recurso-deshabilitado" : "")" data-recursoid="@r.recursoid">
                    <div class="cal-resource-name d-flex align-items-center justify-content-between">
                        <span>
                            @r.nombre
                            @if (r.libre == false)
                            {
                                <span class="badge-no-habilitado ms-1" title="No habilitado">
                                    <i class="bi bi-slash-circle-fill"></i>
                                </span>
                            }
                        </span>
                        <button type="button" class="btn-ics-recurso" title="Exportar .ics de esta habitación"
                                onclick="abrirModalICSRecurso(@r.recursoid)">
                            <i class="bi bi-download"></i>
                        </button>
                    </div>
                    <div class="cal-resource-meta">
                        @if (r.capacidad.HasValue)
                        {
                            <span><i class="bi bi-people-fill"></i> @r.capacidad</span>
                        }
                        @if (r.precio.HasValue)
                        {
                            <span>$@r.precio.Value.ToString("N0")/noche</span>
                        }
                        @if (r.libre == false)
                        {
                            <span style="color:#7B1FA2;font-weight:700;">No habilitado</span>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Zona scrollable de días -->
        <div class="cal-timeline-wrap" id="timelineWrap">
            <!-- Header de días (generado por JS) -->
            <div class="cal-days-header" id="diasHeader"></div>

            <!-- Grid de reservas (generado por JS) -->
            <div class="cal-grid" id="calGrid"></div>
        </div>
    </div>

</div>

<!-- ========================================
     POPOVER DE RESERVA
======================================== -->
<div class="cal-popover" id="calPopover" style="display:none;">
    <div class="cal-popover-arrow"></div>
    <div class="cal-popover-header">
        <span class="cal-popover-title" id="popHuesped">—</span>
        <button class="cal-popover-close" id="btnCerrarPopover">&times;</button>
    </div>
    <div class="cal-popover-body">
        <div class="pop-row"><i class="bi bi-telephone-fill"></i><span id="popTelefono">—</span></div>
        <div class="pop-row"><i class="bi bi-envelope-fill"></i><span id="popCorreo">—</span></div>
        <div class="pop-row"><i class="bi bi-calendar2-range-fill"></i><span id="popFechas">—</span></div>
        <div class="pop-row"><i class="bi bi-currency-dollar"></i><span id="popPrecio">—</span></div>
        <div class="pop-row">
            <i class="bi bi-tag-fill"></i>
            <span id="popEstadoBadge" class="cb-badge" style="font-size:10px;"></span>
        </div>
    </div>

    <!-- Botones de cambio de estado -->
    <div class="pop-estado-acciones" id="popEstadoAcciones">
        <div class="pop-estado-label">Cambiar estado:</div>
        <div class="pop-estado-btns">
            <button class="pop-estado-btn estado-btn-2" id="popBtnEnProceso"
                    data-estadoid="2" title="En proceso">
                <i class="bi bi-hourglass-split"></i> En proceso
            </button>
            <button class="pop-estado-btn estado-btn-1" id="popBtnReservado"
                    data-estadoid="1" title="Reservado">
                <i class="bi bi-calendar-check"></i> Reservado
            </button>
            <button class="pop-estado-btn estado-btn-3" id="popBtnDisponible"
                    data-estadoid="3" title="Marcar como Disponible">
                <i class="bi bi-check2-circle"></i> Disponible
            </button>
        </div>
        <div id="popEstadoFeedback" style="display:none;"></div>
    </div>

    <div class="cal-popover-footer">
        <a id="popLinkExportar" href="#" class="cb-btn cb-btn-outline" style="font-size:12px; padding:5px 12px;">
            <i class="bi bi-download"></i> .ics
        </a>
        <!-- ✅ Botón Cancelar reserva en popover -->
        <button id="btnCancelarReservaPopover" class="cb-btn" style="font-size:12px; padding:5px 12px; background:#FFF0F0; color:#C0392B; border:1.5px solid #E74C3C;">
            <i class="bi bi-x-circle-fill"></i> Cancelar
        </button>
        <button id="btnEditarReservaPopover" class="cb-btn cb-btn-primary" style="font-size:12px; padding:5px 12px;">
            <i class="bi bi-pencil-fill"></i> Editar
        </button>
    </div>
</div>

<!-- ========================================
     MODAL: CANCELAR RESERVA (con % reembolso)
======================================== -->
<div class="modal fade" id="modalCancelarReserva" tabindex="-1" aria-labelledby="modalCancelarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:440px;">
        <div class="modal-content cb-modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#E74C3C,#C0392B);color:#fff;border-bottom:none;padding:20px 24px;">
                <h5 class="modal-title" id="modalCancelarLabel">
                    <i class="bi bi-x-circle-fill me-2"></i>Cancelar Reserva
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="cancelarInfoReserva" class="mb-3 p-3" style="background:#FFF5F5;border-radius:10px;border:1px solid #FFCDD2;font-size:13px;"></div>

                <label class="cb-label">¿Cuánto reembolso se dará al huésped?</label>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <input type="range" id="cancelarPorcentajeSlider" min="0" max="100" value="100"
                           style="flex:1;accent-color:#E74C3C;" />
                    <div class="d-flex align-items-center gap-1">
                        <input type="number" id="cancelarPorcentajeInput" min="0" max="100" value="100"
                               style="width:65px;" class="cb-form-control text-center" />
                        <span style="font-weight:700;color:#666;">%</span>
                    </div>
                </div>
                <div id="cancelarMontoReembolso" class="mt-2" style="font-size:13px;font-weight:600;color:#1A8C6E;"></div>
                <div class="cb-alert cb-alert-danger mt-3" id="cancelarAlertaError" style="display:none;"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--cb-border);padding:16px 24px;">
                <button type="button" class="cb-btn cb-btn-outline" data-bs-dismiss="modal">No, volver</button>
                <button type="button" class="cb-btn" id="btnConfirmarCancelacion"
                        style="background:#E74C3C;color:#fff;border:none;">
                    <i class="bi bi-x-circle-fill"></i> Sí, cancelar reserva
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================
     MODAL: CREAR RESERVA
======================================== -->
<div class="modal fade" id="modalCrearReserva" tabindex="-1" aria-labelledby="modalCrearReservaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content cb-modal-content">

            <div class="modal-header cb-modal-header">
                <h5 class="modal-title" id="modalCrearReservaLabel">
                    <i class="bi bi-calendar-plus-fill me-2"></i>Nueva Reserva
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-3">

                    <!-- Habitación -->
                    <div class="col-md-6">
                        <label class="cb-label">Habitación</label>
                        <select class="cb-form-control" id="modalRecursoid">
                            @foreach (var r in Model)
                            {
                                var isDisabled = r.libre == false;
                                var optLabel = isDisabled ? $"{r.nombre} — No habilitada" : r.nombre;
                                if (isDisabled)
                                {
                                    <option value="@r.recursoid" disabled class="opt-bloqueada">@optLabel</option>
                                }
                                else
                                {
                                    <option value="@r.recursoid">@optLabel</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6">
                        <label class="cb-label">Estado</label>
                        <select class="cb-form-control" id="modalEstadoid">
                            <option value="1">Reservado</option>
                            <option value="2">En proceso</option>
                        </select>
                    </div>

                    <!-- Fecha inicio -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Fecha entrada</label>
                        <input type="date" class="cb-form-control" id="modalFechaInicio" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Hora entrada -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Hora entrada</label>
                        <input type="time" class="cb-form-control" id="modalHoraInicio" value="15:00" />
                    </div>

                    <!-- Fecha fin -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Fecha salida</label>
                        <input type="date" class="cb-form-control" id="modalFechaFin" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Hora salida -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Hora salida</label>
                        <input type="time" class="cb-form-control" id="modalHoraSalida" value="13:00" />
                    </div>

                    <!-- Precio + Mini calculadora -->
                    <div class="col-md-6">
                        <label class="cb-label">Precio final ($)</label>
                        <div class="precio-calc-wrap">
                            <input type="number" class="cb-form-control precio-input" id="modalPrecio" placeholder="0.00" min="0" step="0.01" />
                            <!-- ✅ Mini calculadora -->
                            <div class="mini-calc" id="miniCalcCrear">
                                <button type="button" class="mini-calc-toggle" id="btnMiniCalcCrear" title="Calculadora rápida">
                                    <i class="bi bi-calculator-fill"></i>
                                </button>
                                <div class="mini-calc-panel" id="miniCalcPanelCrear" style="display:none;">
                                    <span class="mini-calc-base" id="miniCalcBaseCrear"></span>
                                    <select class="mini-calc-op" id="miniCalcOpCrear">
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                        <option value="*">×</option>
                                        <option value="/">÷</option>
                                    </select>
                                    <input type="number" class="mini-calc-val" id="miniCalcValCrear" placeholder="0" step="0.01" />
                                    <button type="button" class="mini-calc-apply" id="btnMiniCalcApplyCrear" title="Aplicar">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="modal-precio-info" id="modalPrecioInfo" style="display:none;">
                            <i class="bi bi-info-circle"></i>
                            <span id="modalPrecioInfoTexto"></span>
                        </div>
                    </div>

                    <!-- BUSCADOR DE CLIENTE -->
                    <div class="col-12">
                        <label class="cb-label">Huésped</label>
                        <div class="cliente-search-wrap">
                            <div class="cliente-selected" id="clienteSelected" style="display:none;">
                                <i class="bi bi-person-check-fill"></i>
                                <span id="clienteSelectedNombre"></span>
                                <button type="button" class="cliente-clear-btn" id="btnClearCliente">&times;</button>
                            </div>
                            <input type="text" class="cb-form-control" id="inputBuscarCliente"
                                   placeholder="Escribe nombre o correo del huésped..."
                                   autocomplete="off" />
                            <div class="cliente-dropdown" id="clienteDropdown" style="display:none;"></div>
                        </div>
                        <input type="hidden" id="modalClienteId" value="" />
                    </div>

                    <!-- FORMULARIO CREAR CLIENTE (oculto por defecto) -->
                    <div class="col-12" id="seccionCrearCliente" style="display:none;">
                        <div class="crear-cliente-card">
                            <div class="crear-cliente-header">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Nuevo cliente</span>
                                <button type="button" class="crear-cliente-close" id="btnCerrarCrearCliente">&times;</button>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-md-6">
                                    <input type="text" class="cb-form-control" id="nuevoNombre" placeholder="Nombre *" />
                                    <div class="campo-error" id="errNombre" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="cb-form-control" id="nuevoApellido" placeholder="Apellido *" />
                                    <div class="campo-error" id="errApellido" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="cb-form-control" id="nuevoCorreo" placeholder="Correo *" />
                                    <div class="campo-error" id="errCorreo" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row g-1">
                                        <div class="col-5">
                                            <select class="cb-form-control" id="nuevoCodigoPais" style="font-size:12px;">
                                                <option value="">Código *</option>
                                                <option value="+1">+1 (USA/Canadá)</option>
                                                <option value="+52">+52 (México)</option>
                                                <option value="+501">+501 (Belice)</option>
                                                <option value="+502">+502 (Guatemala)</option>
                                                <option value="+503">+503 (El Salvador)</option>
                                                <option value="+504">+504 (Honduras)</option>
                                                <option value="+505">+505 (Nicaragua)</option>
                                                <option value="+506">+506 (Costa Rica)</option>
                                                <option value="+507">+507 (Panamá)</option>
                                                <option value="+53">+53 (Cuba)</option>
                                                <option value="+509">+509 (Haití)</option>
                                                <option value="+1809">+1-809 (R. Dominicana)</option>
                                                <option value="+1876">+1-876 (Jamaica)</option>
                                                <option value="+1787">+1-787 (Puerto Rico)</option>
                                                <option value="+54">+54 (Argentina)</option>
                                                <option value="+55">+55 (Brasil)</option>
                                                <option value="+56">+56 (Chile)</option>
                                                <option value="+57">+57 (Colombia)</option>
                                                <option value="+58">+58 (Venezuela)</option>
                                                <option value="+51">+51 (Perú)</option>
                                                <option value="+591">+591 (Bolivia)</option>
                                                <option value="+593">+593 (Ecuador)</option>
                                                <option value="+595">+595 (Paraguay)</option>
                                                <option value="+598">+598 (Uruguay)</option>
                                                <option value="+592">+592 (Guyana)</option>
                                                <option value="+597">+597 (Surinam)</option>
                                            </select>
                                        </div>
                                        <div class="col-7">
                                            <input type="text" class="cb-form-control" id="nuevoNumeroTelefono"
                                                   placeholder="Número *" maxlength="11" />
                                        </div>
                                    </div>
                                    <small id="nuevoTelefonoHelp" style="font-size:11px;color:var(--cb-text-muted);">
                                        Selecciona un código de país
                                    </small>
                                    <div class="campo-error" id="errTelefono" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-12">
                                    <button type="button" class="cb-btn cb-btn-primary w-100" id="btnGuardarNuevoCliente">
                                        <i class="bi bi-check-lg"></i> Guardar cliente y continuar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Alerta de error -->
                <div class="cb-alert cb-alert-danger mt-3" id="alertaError" style="display:none;"></div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--cb-border); padding: 16px 24px;">
                <button type="button" class="cb-btn cb-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="cb-btn cb-btn-primary" id="btnGuardarReserva">
                    <i class="bi bi-check-lg"></i> Guardar reserva
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ========================================
     MODAL: EDITAR RESERVA
======================================== -->
<div class="modal fade" id="modalEditarReserva" tabindex="-1" aria-labelledby="modalEditarReservaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content cb-modal-content">

            <div class="modal-header cb-modal-header">
                <h5 class="modal-title" id="modalEditarReservaLabel">
                    <i class="bi bi-pencil-fill me-2"></i>Editar Reserva
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <div class="row g-3">

                    <!-- Habitación -->
                    <div class="col-md-6">
                        <label class="cb-label">Habitación</label>
                        <select class="cb-form-control" id="editRecursoid">
                            @foreach (var r in Model)
                            {
                                var isDisabled = r.libre == false;
                                var optLabel = isDisabled ? $"{r.nombre} — No habilitada" : r.nombre;
                                if (isDisabled)
                                {
                                    <option value="@r.recursoid" disabled class="opt-bloqueada">@optLabel</option>
                                }
                                else
                                {
                                    <option value="@r.recursoid">@optLabel</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6">
                        <label class="cb-label">Estado</label>
                        <select class="cb-form-control" id="editEstadoid">
                            <option value="1">Reservado</option>
                            <option value="2">En proceso</option>
                            <option value="3">Disponible</option>
                        </select>
                    </div>

                    <!-- Fecha inicio -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Fecha entrada</label>
                        <input type="date" class="cb-form-control" id="editFechaInicio" />
                    </div>

                    <!-- Hora entrada -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Hora entrada</label>
                        <input type="time" class="cb-form-control" id="editHoraInicio" value="15:00" />
                    </div>

                    <!-- Fecha fin -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Fecha salida</label>
                        <input type="date" class="cb-form-control" id="editFechaFin" />
                    </div>

                    <!-- Hora salida -->
                    <div class="col-6 col-md-3">
                        <label class="cb-label">Hora salida</label>
                        <input type="time" class="cb-form-control" id="editHoraSalida" value="13:00" />
                    </div>

                    <!-- Precio + Mini calculadora -->
                    <div class="col-md-6">
                        <label class="cb-label">Precio final ($)</label>
                        <div class="precio-calc-wrap">
                            <input type="number" class="cb-form-control precio-input" id="editPrecio" placeholder="0.00" min="0" step="0.01" />
                            <!-- ✅ Mini calculadora -->
                            <div class="mini-calc" id="miniCalcEditar">
                                <button type="button" class="mini-calc-toggle" id="btnMiniCalcEditar" title="Calculadora rápida">
                                    <i class="bi bi-calculator-fill"></i>
                                </button>
                                <div class="mini-calc-panel" id="miniCalcPanelEditar" style="display:none;">
                                    <span class="mini-calc-base" id="miniCalcBaseEditar"></span>
                                    <select class="mini-calc-op" id="miniCalcOpEditar">
                                        <option value="+">+</option>
                                        <option value="-">-</option>
                                        <option value="*">×</option>
                                        <option value="/">÷</option>
                                    </select>
                                    <input type="number" class="mini-calc-val" id="miniCalcValEditar" placeholder="0" step="0.01" />
                                    <button type="button" class="mini-calc-apply" id="btnMiniCalcApplyEditar" title="Aplicar">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="modal-precio-info" id="editPrecioInfo" style="display:none;">
                            <i class="bi bi-info-circle"></i>
                            <span id="editPrecioInfoTexto"></span>
                        </div>
                    </div>

                    <!-- BUSCADOR DE CLIENTE -->
                    <div class="col-12">
                        <label class="cb-label">Huésped</label>
                        <div class="cliente-search-wrap">
                            <div class="cliente-selected" id="editClienteSelected" style="display:none;">
                                <i class="bi bi-person-check-fill"></i>
                                <span id="editClienteSelectedNombre"></span>
                                <button type="button" class="cliente-clear-btn" id="btnEditClearCliente">&times;</button>
                            </div>
                            <input type="text" class="cb-form-control" id="editInputBuscarCliente"
                                   placeholder="Escribe nombre o correo del huésped..."
                                   autocomplete="off" />
                            <div class="cliente-dropdown" id="editClienteDropdown" style="display:none;"></div>
                        </div>
                        <input type="hidden" id="editClienteId" value="" />
                    </div>

                    <!-- FORMULARIO CREAR CLIENTE en editar (oculto por defecto) -->
                    <div class="col-12" id="editSeccionCrearCliente" style="display:none;">
                        <div class="crear-cliente-card">
                            <div class="crear-cliente-header">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Nuevo cliente</span>
                                <button type="button" class="crear-cliente-close" id="btnEditCerrarCrearCliente">&times;</button>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-md-6">
                                    <input type="text" class="cb-form-control" id="editNuevoNombre" placeholder="Nombre *" />
                                    <div class="campo-error" id="editErrNombre" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="cb-form-control" id="editNuevoApellido" placeholder="Apellido *" />
                                    <div class="campo-error" id="editErrApellido" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <input type="email" class="cb-form-control" id="editNuevoCorreo" placeholder="Correo *" />
                                    <div class="campo-error" id="editErrCorreo" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row g-1">
                                        <div class="col-5">
                                            <select class="cb-form-control" id="editNuevoCodigoPais" style="font-size:12px;">
                                                <option value="">Código *</option>
                                                <option value="+1">+1 (USA/Canadá)</option>
                                                <option value="+52">+52 (México)</option>
                                                <option value="+501">+501 (Belice)</option>
                                                <option value="+502">+502 (Guatemala)</option>
                                                <option value="+503">+503 (El Salvador)</option>
                                                <option value="+504">+504 (Honduras)</option>
                                                <option value="+505">+505 (Nicaragua)</option>
                                                <option value="+506">+506 (Costa Rica)</option>
                                                <option value="+507">+507 (Panamá)</option>
                                                <option value="+53">+53 (Cuba)</option>
                                                <option value="+509">+509 (Haití)</option>
                                                <option value="+1809">+1-809 (R. Dominicana)</option>
                                                <option value="+1876">+1-876 (Jamaica)</option>
                                                <option value="+1787">+1-787 (Puerto Rico)</option>
                                                <option value="+54">+54 (Argentina)</option>
                                                <option value="+55">+55 (Brasil)</option>
                                                <option value="+56">+56 (Chile)</option>
                                                <option value="+57">+57 (Colombia)</option>
                                                <option value="+58">+58 (Venezuela)</option>
                                                <option value="+51">+51 (Perú)</option>
                                                <option value="+591">+591 (Bolivia)</option>
                                                <option value="+593">+593 (Ecuador)</option>
                                                <option value="+595">+595 (Paraguay)</option>
                                                <option value="+598">+598 (Uruguay)</option>
                                                <option value="+592">+592 (Guyana)</option>
                                                <option value="+597">+597 (Surinam)</option>
                                            </select>
                                        </div>
                                        <div class="col-7">
                                            <input type="text" class="cb-form-control" id="editNuevoNumeroTelefono"
                                                   placeholder="Número *" maxlength="11" />
                                        </div>
                                    </div>
                                    <small id="editNuevoTelefonoHelp" style="font-size:11px;color:var(--cb-text-muted);">
                                        Selecciona un código de país
                                    </small>
                                    <div class="campo-error" id="editErrTelefono" style="display:none;color:var(--cb-danger);font-size:11px;margin-top:3px;"></div>
                                </div>
                                <div class="col-12">
                                    <button type="button" class="cb-btn cb-btn-primary w-100" id="btnEditGuardarNuevoCliente">
                                        <i class="bi bi-check-lg"></i> Guardar cliente y continuar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Alerta de error -->
                <div class="cb-alert cb-alert-danger mt-3" id="editAlertaError" style="display:none;"></div>
            </div>

            <div class="modal-footer" style="border-top: 1px solid var(--cb-border); padding: 16px 24px;">
                <!-- ✅ Botón cancelar reserva en modal editar -->
                <button type="button" class="cb-btn me-auto" id="btnCancelarDesdeEditar"
                        style="background:#FFF0F0;color:#C0392B;border:1.5px solid #E74C3C;font-size:13px;">
                    <i class="bi bi-x-circle-fill"></i> Cancelar reserva
                </button>
                <button type="button" class="cb-btn cb-btn-outline" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="cb-btn cb-btn-primary" id="btnGuardarEdicion">
                    <i class="bi bi-check-lg"></i> Guardar cambios
                </button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL: EXPORTAR ICS -->
<div class="modal fade" id="modalExportarICS" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content cb-modal-content">
            <div class="modal-header cb-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-download me-2"></i>Exportar calendario .ics
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p style="font-size:13px;color:var(--cb-text-muted);margin-bottom:16px;">
                    Selecciona el rango de fechas a exportar:
                </p>

                <!-- Opciones rápidas -->
                <div class="row g-2">
                    <div class="col-6">
                        <label class="cb-label">Desde</label>
                        <input type="date" class="cb-form-control" id="icsDesde" />
                    </div>
                    <div class="col-6">
                        <label class="cb-label">Hasta</label>
                        <input type="date" class="cb-form-control" id="icsHasta" />
                    </div>
                </div>
                <div class="d-flex justify-content-between mt-2">
                    <div class="d-flex gap-1 flex-wrap">
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(7, 'pasado')">-1sem</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(30, 'pasado')">-1mes</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(90, 'pasado')">-3mes</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(365, 'pasado')">-1año</button>
                    </div>
                    <div class="d-flex gap-1 flex-wrap justify-content-end">
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(7, 'futuro')">+1sem</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(30, 'futuro')">+1mes</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(90, 'futuro')">+3mes</button>
                        <button type="button" class="ics-rango-btn" onclick="setRangoICS(365, 'futuro')">+1año</button>
                    </div>
                </div>

                <div class="cb-alert cb-alert-danger mt-3" id="icsAlertaError" style="display:none;"></div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--cb-border);padding:16px 24px;">
                <button type="button" class="cb-btn cb-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="cb-btn cb-btn-primary" id="btnConfirmarExportarICS">
                    <i class="bi bi-download"></i> Descargar .ics
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* =========================================
           VARIABLES CALENDARIO
        ========================================= */
    :root {
        --cal-reservado: #29B6D2;
        --cal-proceso: #F5A623;
        --cal-activo: #2ECC9A;
        --cal-pill-h: 36px;
        --cal-row-h: 64px;
        --cal-day-w: 44px;
        --cal-resource-w: 220px;
        --cal-header-h: 48px;
    }

    /* =========================================
           BARRA DE NAVEGACIÓN
        ========================================= */
    .cal-nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 16px;
        background: var(--cb-surface);
        border-bottom: 1px solid var(--cb-border);
        position: sticky;
        top: 0;
        z-index: 50;
        gap: 8px;
        flex-wrap: wrap;
    }

    .cal-nav-left {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 0;
    }

    .cal-nav-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1.5px solid var(--cb-border);
        background: transparent;
        color: var(--cb-text-main);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        transition: all 0.15s;
        flex-shrink: 0;
    }

        .cal-nav-btn:hover {
            background: var(--cb-primary-pale);
            border-color: var(--cb-primary);
            color: var(--cb-primary);
        }

    .cal-nav-btn-today {
        height: 34px;
        padding: 0 10px;
        border-radius: 8px;
        border: 1.5px solid var(--cb-primary);
        background: var(--cb-primary-pale);
        color: var(--cb-primary-dark);
        cursor: pointer;
        font-size: 12px;
        font-weight: 600;
        font-family: var(--font-body);
        transition: all 0.15s;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .cal-nav-btn-today:hover {
            background: var(--cb-primary);
            color: #fff;
        }

    .cal-mes-label {
        font-family: var(--font-heading);
        font-size: 15px;
        font-weight: 700;
        color: var(--cb-text-main);
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (min-width: 576px) {
        .cal-mes-label

    {
        font-size: 18px;
        min-width: 180px;
        text-align: center;
    }

    .cal-nav-bar {
        padding: 14px 28px;
        gap: 16px;
    }

    .cal-nav-left {
        gap: 8px;
    }

    .cal-nav-btn-today {
        padding: 0 14px;
        font-size: 13px;
    }

    }

    .cal-nav-right {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cal-search-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .cal-search-icon {
        position: absolute;
        left: 10px;
        color: var(--cb-text-muted);
        font-size: 13px;
        pointer-events: none;
    }

    .cal-search-input {
        border: 1.5px solid var(--cb-border);
        border-radius: 20px;
        padding: 7px 12px 7px 30px;
        font-size: 12px;
        font-family: var(--font-body);
        width: 150px;
        background: var(--cb-bg);
        color: var(--cb-text-main);
        transition: all 0.2s;
    }

    @@media (min-width: 576px) {
        .cal-search-input

    {
        width: 200px;
        font-size: 13px;
        padding: 8px 16px 8px 36px;
    }

    .cal-search-icon {
        left: 12px;
        font-size: 14px;
    }

    }

    @@media (min-width: 992px) {
        .cal-search-input

    {
        width: 220px;
    }

    }

    .cal-search-input:focus {
        outline: none;
        border-color: var(--cb-primary);
        background: var(--cb-white);
        box-shadow: 0 0 0 3px rgba(41,182,210,0.12);
    }

    /* =========================================
           LEYENDA
        ========================================= */
    .cal-leyenda {
        display: flex;
        gap: 10px;
        padding: 6px 14px;
        background: var(--cb-bg);
        border-bottom: 1px solid var(--cb-border);
        flex-wrap: wrap;
        overflow-x: auto;
    }

    @@media (min-width: 576px) {
        .cal-leyenda

    {
        gap: 20px;
        padding: 8px 28px;
        flex-wrap: nowrap;
    }

    }

    .leyenda-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        color: var(--cb-text-muted);
        font-family: var(--font-body);
        white-space: nowrap;
    }

    @@media (min-width: 576px) {
        .leyenda-item

    {
        font-size: 12px;
        gap: 6px;
    }

    }

    .leyenda-dot {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        display: inline-block;
        flex-shrink: 0;
    }

    /* =========================================
           WRAPPER PRINCIPAL
        ========================================= */
    .cal-wrapper {
        display: flex;
        height: calc(100vh - 240px);
        min-height: 300px;
        overflow: hidden;
        background: var(--cb-bg);
    }

    @@media (min-width: 576px) {
        .cal-wrapper

    {
        height: calc(100vh - 230px);
        min-height: 400px;
    }

    }

    /* =========================================
           COLUMNA DE RECURSOS
        ========================================= */
    .cal-resources-col {
        width: 140px;
        flex-shrink: 0;
        background: var(--cb-surface);
        border-right: 2px solid var(--cb-border);
        overflow-y: auto;
        overflow-x: hidden;
        z-index: 10;
        box-shadow: 3px 0 12px rgba(0,0,0,0.06);
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    @@media (min-width: 576px) {
        .cal-resources-col

    {
        width: 180px;
    }

    }

    @@media (min-width: 992px) {
        .cal-resources-col

    {
        width: var(--cal-resource-w);
    }

    }

    .cal-resources-col::-webkit-scrollbar {
        display: none;
    }

    .cal-resources-header {
        height: var(--cal-header-h);
        display: flex;
        align-items: center;
        padding: 0 12px;
        font-family: var(--font-heading);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--cb-text-muted);
        background: var(--cb-primary-pale);
        border-bottom: 1px solid var(--cb-border);
        position: sticky;
        top: 0;
        z-index: 5;
    }

    @@media (min-width: 576px) {
        .cal-resources-header

    {
        padding: 0 20px;
        font-size: 11px;
    }

    }

    .cal-resource-row {
        height: var(--cal-row-h);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 10px;
        border-bottom: 1px solid var(--cb-border);
        cursor: default;
        transition: background 0.15s;
    }

    @@media (min-width: 576px) {
        .cal-resource-row

    {
        padding: 0 20px;
    }

    }

    .cal-resource-row:hover {
        background: var(--cb-primary-pale);
    }

    /* ✅ Estilo para habitaciones no habilitadas */
    .cal-resource-row.recurso-deshabilitado {
        background: #FAF5FF;
        opacity: 0.75;
    }

        .cal-resource-row.recurso-deshabilitado:hover {
            background: #F3E8FF;
        }

    .badge-no-habilitado {
        color: #7B1FA2;
        font-size: 10px;
        vertical-align: middle;
    }

    .cal-resource-name {
        font-family: var(--font-heading);
        font-size: 12px;
        font-weight: 700;
        color: var(--cb-text-main);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @@media (min-width: 576px) {
        .cal-resource-name

    {
        font-size: 13px;
    }

    }

    .cal-resource-meta {
        display: flex;
        gap: 6px;
        margin-top: 2px;
        font-size: 10px;
        color: var(--cb-text-muted);
        flex-wrap: wrap;
    }

    @@media (min-width: 576px) {
        .cal-resource-meta

    {
        gap: 10px;
        font-size: 11px;
    }

    }

    .cal-resource-meta i {
        font-size: 10px;
    }

    /* =========================================
           ZONA DE TIMELINE
        ========================================= */
    .cal-timeline-wrap {
        flex: 1;
        overflow-x: auto;
        overflow-y: auto;
        position: relative;
        -webkit-overflow-scrolling: touch;
    }

        .cal-timeline-wrap::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }

        .cal-timeline-wrap::-webkit-scrollbar-track {
            background: var(--cb-bg);
        }

        .cal-timeline-wrap::-webkit-scrollbar-thumb {
            background: var(--cb-border);
            border-radius: 4px;
        }

    /* Header de días */
    .cal-days-header {
        display: flex;
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--cb-surface);
        border-bottom: 2px solid var(--cb-border);
        height: var(--cal-header-h);
    }

    .cal-day-header-cell {
        width: var(--cal-day-w);
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-right: 1px solid var(--cb-border);
        font-size: 11px;
        font-family: var(--font-body);
        color: var(--cb-text-muted);
        cursor: default;
        transition: background 0.1s;
    }

        .cal-day-header-cell.weekend {
            background: #F7FBFC;
        }

        .cal-day-header-cell.today {
            background: var(--cb-primary-pale);
            color: var(--cb-primary-dark);
            font-weight: 700;
        }

        .cal-day-header-cell .day-num {
            font-size: 15px;
            font-weight: 700;
            font-family: var(--font-heading);
            line-height: 1;
        }

        .cal-day-header-cell .day-name {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-top: 1px;
        }

    /* Grid */
    .cal-grid {
        position: relative;
    }

    .cal-grid-row {
        display: flex;
        height: var(--cal-row-h);
        border-bottom: 1px solid var(--cb-border);
        position: relative;
    }

    .cal-grid-cell {
        width: var(--cal-day-w);
        flex-shrink: 0;
        border-right: 1px solid rgba(201,232,240,0.5);
        position: relative;
        cursor: pointer;
        transition: background 0.12s;
    }

        .cal-grid-cell.weekend {
            background: rgba(247,251,252,0.7);
        }

        .cal-grid-cell.today-col {
            background: rgba(41,182,210,0.06);
        }

        /* Celda bloqueada: habitación ocupada */
        .cal-grid-cell.cell-bloqueada {
            background: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(180,180,200,0.13) 5px, rgba(180,180,200,0.13) 10px);
            cursor: not-allowed;
        }

            .cal-grid-cell.cell-bloqueada:hover {
                background: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(180,180,200,0.20) 5px, rgba(180,180,200,0.20) 10px);
            }

        /* ✅ Celda no habilitada: recurso deshabilitado */
        .cal-grid-cell.cell-no-habilitada {
            background: repeating-linear-gradient(45deg, #F3E8FF, #F3E8FF 5px, #EDD5FF 5px, #EDD5FF 10px);
            cursor: not-allowed;
            opacity: 0.7;
        }

            .cal-grid-cell.cell-no-habilitada:hover {
                background: repeating-linear-gradient(45deg, #F3E8FF, #F3E8FF 5px, #E1C4F7 5px, #E1C4F7 10px);
            }

        /* Celda de checkout */
        .cal-grid-cell.cell-checkout {
            background: linear-gradient(to bottom, rgba(46,204,154,0.08) 0%, transparent 100%);
        }

        /* Celda pasado */
        .cal-grid-cell.cell-pasado {
            background: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(180,180,200,0.13) 5px, rgba(180,180,200,0.13) 10px);
            opacity: 0.45;
            cursor: not-allowed;
        }

            .cal-grid-cell.cell-pasado:hover {
                background: repeating-linear-gradient(45deg, transparent, transparent 5px, rgba(180,180,200,0.20) 5px, rgba(180,180,200,0.20) 10px);
            }

    .cell-checkout-tag {
        position: absolute;
        top: 4px;
