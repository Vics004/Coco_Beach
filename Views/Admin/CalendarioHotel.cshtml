</style>

<script>
    // =========================================
    // DATOS DEL SERVIDOR
    // =========================================
    const TIPO_CAL = '@tipoCalendario';
    // ✅ Ahora incluimos la propiedad 'libre' para saber si está habilitada
    const RECURSOS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.Select(r => new { r.recursoid, r.nombre, r.precio, r.capacidad, libre = r.libre ?? true })
        ));

    // IDs de recursos deshabilitados (se completa desde el servidor al cargar)
    let recursosDeshabilitadosIds = new Set(RECURSOS.filter(r => !r.libre).map(r => r.recursoid));

    // =========================================
    // ESTADO GLOBAL
    // =========================================
    let mesActual = new Date();
    mesActual.setDate(1);
    let todasLasReservas = [];
    let reservasFiltradas = [];
    let clienteSeleccionado = null;
    let searchTimeout = null;

    const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio',
                   'Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
    const DIAS_CORTO = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];

    // =========================================
    // INICIALIZACIÓN
    // =========================================
    document.addEventListener('DOMContentLoaded', () => {
        renderCalendario();
        cargarReservas();
        bindEventos();
        initMiniCalcs();
    });

    // =========================================
    // RENDER PRINCIPAL
    // =========================================
    function renderCalendario() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const hoy = new Date();

        document.getElementById('mesLabel').textContent = `${MESES[mes]} ${año}`;

        // --- Header de días ---
        const diasHeader = document.getElementById('diasHeader');
        diasHeader.innerHTML = '';
        for (let d = 1; d <= diasEnMes; d++) {
            const fecha = new Date(año, mes, d);
            const esFinde = fecha.getDay() === 0 || fecha.getDay() === 6;
            const esHoy = fecha.toDateString() === hoy.toDateString();
            const cell = document.createElement('div');
            cell.className = 'cal-day-header-cell' +
                (esFinde ? ' weekend' : '') +
                (esHoy ? ' today' : '');
            cell.innerHTML = `<span class="day-num">${d}</span>
                              <span class="day-name">${DIAS_CORTO[fecha.getDay()]}</span>`;
            diasHeader.appendChild(cell);
        }

        // --- Grid de filas ---
        const grid = document.getElementById('calGrid');
        grid.innerHTML = '';

        const totalW = diasEnMes * 44;
        grid.style.width = totalW + 'px';

        // Línea de hoy
        if (hoy.getFullYear() === año && hoy.getMonth() === mes) {
            const todayLine = document.createElement('div');
            todayLine.className = 'cal-today-line';
            todayLine.style.left = ((hoy.getDate() - 1) * 44 + 22) + 'px';
            grid.appendChild(todayLine);
        }

        RECURSOS.forEach(recurso => {
            const row = document.createElement('div');
            row.className = 'cal-grid-row';
            row.dataset.recursoid = recurso.recursoid;

            // ✅ Si el recurso NO está habilitado, aplicar estilo especial a toda la fila
            const estaDeshabilitado = recursosDeshabilitadosIds.has(recurso.recursoid);

            for (let d = 1; d <= diasEnMes; d++) {
                const fecha = new Date(año, mes, d);
                const esFinde = fecha.getDay() === 0 || fecha.getDay() === 6;
                const esHoy = fecha.toDateString() === hoy.toDateString();
                const esPasado = fecha < new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate());

                const cell = document.createElement('div');
                let clases = 'cal-grid-cell';
                if (esFinde) clases += ' weekend';
                if (esHoy) clases += ' today-col';

                // ✅ Prioridad: si está deshabilitado, siempre bloqueado
                if (estaDeshabilitado) {
                    clases += ' cell-no-habilitada';
                    cell.className = clases;
                    cell.title = 'Habitación no habilitada';
                    cell.dataset.fecha = formatDate(fecha);
                    cell.dataset.recursoid = recurso.recursoid;
                    cell.dataset.disp = 'no-habilitada';
                } else {
                    const disp = calcularDisponibilidadCelda(recurso.recursoid, fecha);
                    if (esPasado) clases += ' cell-pasado';
                    else if (disp === 'bloqueado') clases += ' cell-bloqueada';
                    else if (disp === 'checkout') clases += ' cell-checkout';
                    cell.className = clases;
                    cell.dataset.fecha = formatDate(fecha);
                    cell.dataset.recursoid = recurso.recursoid;
                    cell.dataset.disp = disp;

                    if (esPasado) {
                        cell.title = 'No se pueden crear reservas en fechas pasadas';
                    } else if (disp === 'bloqueado') {
                        cell.title = 'Habitación ocupada este día';
                    } else {
                        const addBtn = document.createElement('div');
                        addBtn.className = 'cell-add-btn';
                        addBtn.innerHTML = '+';
                        cell.appendChild(addBtn);

                        if (disp === 'checkout') {
                            const tag = document.createElement('div');
                            tag.className = 'cell-checkout-tag';
                            tag.title = 'Salida hoy — disponible desde las 3pm';
                            tag.innerHTML = '<i class="bi bi-arrow-right-circle-fill"></i>';
                            cell.appendChild(tag);
                        }

                        cell.addEventListener('click', () => {
                            abrirModalCrear(recurso.recursoid, formatDate(fecha));
                        });
                    }
                }

                row.appendChild(cell);
            }

            grid.appendChild(row);
        });

        sincronizarScroll();
    }

    // =========================================
    // SINCRONIZACIÓN BIDIRECCIONAL DE SCROLL
    // =========================================
    function sincronizarScroll() {
        const wrap = document.getElementById('timelineWrap');
        const recursos = document.getElementById('colRecursos');

        let syncingFromWrap = false;
        let syncingFromRecursos = false;

        wrap.addEventListener('scroll', () => {
            if (syncingFromWrap) return;
            syncingFromRecursos = true;
            recursos.scrollTop = wrap.scrollTop;
            syncingFromRecursos = false;
        });

        recursos.addEventListener('scroll', () => {
            if (syncingFromRecursos) return;
            syncingFromWrap = true;
            wrap.scrollTop = recursos.scrollTop;
            syncingFromWrap = false;
        });
    }

    // =========================================
    // DISPONIBILIDAD POR CELDA
    // =========================================
    function calcularDisponibilidadCelda(recursoid, fecha) {
        // ✅ Excluir también canceladas (estado 4) de la disponibilidad
    const reservasRecurso = todasLasReservas.filter(r =>
        r.recursoid === recursoid && r.estadoid !== 4
    );

        const fechaStr = formatDate(fecha);
        let esBloqueado = false;
        let esCheckout = false;

        for (const r of reservasRecurso) {
            const ini = new Date(r.fecha_inicio);
            const fin = new Date(r.fecha_fin);
            const iniStr = formatDate(ini);
            const finStr = formatDate(fin);

            if (fechaStr === finStr) { esCheckout = true; continue; }
            if (fechaStr > iniStr && fechaStr < finStr) { esBloqueado = true; break; }
            if (fechaStr === iniStr) { esBloqueado = true; break; }
        }

        if (esBloqueado) return 'bloqueado';
        if (esCheckout) return 'checkout';
        return 'libre';
    }

    function aplicarDisponibilidadEnGrid() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();

        RECURSOS.forEach(recurso => {
            const estaDeshabilitado = recursosDeshabilitadosIds.has(recurso.recursoid);

            for (let d = 1; d <= diasEnMes; d++) {
                const fecha = new Date(año, mes, d);
                const fechaStr = formatDate(fecha);
                const cell = document.querySelector(
                    `.cal-grid-row[data-recursoid="${recurso.recursoid}"] .cal-grid-cell[data-fecha="${fechaStr}"]`
                );
                if (!cell) continue;

                const hoyMidnight = new Date();
                hoyMidnight.setHours(0, 0, 0, 0);
                const esPasado = fecha < hoyMidnight;

                const nuevoCell = cell.cloneNode(false);
                nuevoCell.dataset.fecha = fechaStr;
                nuevoCell.dataset.recursoid = recurso.recursoid;

                // Mantener clases de fin de semana y hoy
                if (cell.classList.contains('weekend')) nuevoCell.classList.add('weekend');
                if (cell.classList.contains('today-col')) nuevoCell.classList.add('today-col');

                if (estaDeshabilitado) {
                    nuevoCell.classList.add('cell-no-habilitada');
                    nuevoCell.dataset.disp = 'no-habilitada';
                    nuevoCell.title = 'Habitación no habilitada';
                } else {
                    const disp = calcularDisponibilidadCelda(recurso.recursoid, fecha);
                    nuevoCell.dataset.disp = disp;

                    if (esPasado) {
                        nuevoCell.classList.add('cell-pasado');
                        nuevoCell.title = 'No se pueden crear reservas en fechas pasadas';
                    } else if (disp === 'bloqueado') {
                        nuevoCell.classList.add('cell-bloqueada');
                        nuevoCell.title = 'Habitación ocupada este día';
                    } else {
                        const addBtn = document.createElement('div');
                        addBtn.className = 'cell-add-btn';
                        addBtn.innerHTML = '+';
                        nuevoCell.appendChild(addBtn);

                        if (disp === 'checkout') {
                            nuevoCell.classList.add('cell-checkout');
                            const tag = document.createElement('div');
                            tag.className = 'cell-checkout-tag';
                            tag.title = 'Salida hoy — disponible desde las 3pm';
                            tag.innerHTML = '<i class="bi bi-arrow-right-circle-fill"></i>';
                            nuevoCell.appendChild(tag);
                        }

                        nuevoCell.addEventListener('click', () => {
                            abrirModalCrear(recurso.recursoid, fechaStr);
                        });
                    }
                }

                cell.replaceWith(nuevoCell);
            }
        });
    }

    // =========================================
    // CARGAR RESERVAS (AJAX)
    // =========================================
    async function cargarReservas() {
        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const inicio = formatDate(new Date(año, mes, 1));
        const fin = formatDate(new Date(año, mes, diasEnMes));

        try {
            const resp = await fetch(`/Admin/GetReservas?fechaInicio=${inicio}&fechaFin=${fin}&tipo=${TIPO_CAL}`);
            const data = await resp.json();

            // ✅ El servidor ahora devuelve { reservas: [...], recursosDeshabilitados: [...] }
            if (data.reservas !== undefined) {
                todasLasReservas = data.reservas;
                // Actualizar el set de recursos deshabilitados desde el servidor
                if (data.recursosDeshabilitados) {
                    recursosDeshabilitadosIds = new Set(data.recursosDeshabilitados);
                }
            } else {
                // Compatibilidad: si el servidor devuelve array directo (versión anterior)
                todasLasReservas = Array.isArray(data) ? data : [];
            }

            // Auto-completar reservas vencidas (checkout pasado) → Disponible
            const ahora = new Date();
            const vencidas = todasLasReservas.filter(r => {
                if (r.estadoid === 3 || r.estadoid === 4) return false;
                if (!r.fecha_fin) return false;
                const fin = new Date(r.fecha_fin);
                const checkout = new Date(fin);
                checkout.setHours(13, 0, 0, 0);
                return ahora >= checkout;
            });

            if (vencidas.length > 0) {
                vencidas.forEach(r => {
                    r.estadoid = 3;
                    fetch('/Admin/CambiarEstadoReserva', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ reservaid: r.reservaid, estadoid: 3 })
                    }).catch(() => {});
                });
            }

            reservasFiltradas = todasLasReservas;
            renderPildoras(todasLasReservas);
            aplicarDisponibilidadEnGrid();
        } catch (e) {
            console.error('Error cargando reservas:', e);
        }
    }

    // =========================================
    // RENDER PÍLDORAS
    // =========================================
    function renderPildoras(reservas) {
        document.querySelectorAll('.cal-pill').forEach(p => p.remove());

        const año = mesActual.getFullYear();
        const mes = mesActual.getMonth();
        const diasEnMes = new Date(año, mes + 1, 0).getDate();
        const primero = new Date(año, mes, 1);
        const ultimo = new Date(año, mes, diasEnMes, 23, 59, 59);

        const rowSlots = {};

        // ✅ Filtrar canceladas (estado 4) del render de píldoras
        const reservasVisibles = reservas.filter(r => r.estadoid !== 4);

        reservasVisibles.forEach(r => {
            const row = document.querySelector(`.cal-grid-row[data-recursoid="${r.recursoid}"]`);
            if (!row) return;

            let inicio = new Date(r.fecha_inicio);
            let fin = new Date(r.fecha_fin);

            const iniVis = inicio < primero ? primero : inicio;
            const finVis = fin > ultimo ? ultimo : fin;

            const diaIni = iniVis.getDate();
            const diaFin = finVis.getDate();
            const duracion = diaFin - diaIni + 1;

            if (duracion <= 0) return;

            if (!rowSlots[r.recursoid]) rowSlots[r.recursoid] = [];
            const slots = rowSlots[r.recursoid];

            let carril = 0;
            let encontrado = false;
            while (!encontrado) {
                const ocupado = slots.some(s => s.carril === carril && s.diaIni <= diaFin && s.diaFin >= diaIni);
                if (!ocupado) encontrado = true;
                else carril++;
            }
            slots.push({ diaIni, diaFin, carril });

            const pillH = 28;
            const pillGap = 4;
            const rowH = 64;
            const totalCarriles = Math.max(...slots.map(s => s.carril)) + 1;
            const totalAltoPills = totalCarriles * pillH + (totalCarriles - 1) * pillGap;
            const offsetBase = (rowH - totalAltoPills) / 2;
            const topPx = offsetBase + carril * (pillH + pillGap);

            const pill = document.createElement('div');
            const estadoClass = [1,2].includes(r.estadoid) ? `estado-${r.estadoid}` : 'estado-otro';
            pill.className = `cal-pill ${estadoClass}`;
            pill.style.left = ((diaIni - 1) * 44 + 3) + 'px';
            pill.style.width = (duracion * 44 - 6) + 'px';
            pill.style.top = topPx + 'px';
            pill.style.transform = 'none';
            pill.style.height = pillH + 'px';

            const nombre = r.cliente ? `${r.cliente.nombre ?? ''} ${r.cliente.apellido ?? ''}`.trim() : `Reserva #${r.reservaid}`;
            pill.innerHTML = `<span class="cal-pill-text">${nombre}</span>`;
            pill.dataset.reservaid = r.reservaid;

            pill.addEventListener('click', (e) => {
                e.stopPropagation();
                mostrarPopover(r, pill);
            });

            row.appendChild(pill);
        });
    }

