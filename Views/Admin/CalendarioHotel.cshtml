        '+501':7,'+502':8,'+503':8,'+504':8,'+505':8,'+506':8,'+507':8,
        '+53':8,'+509':8,'+1809':10,'+1876':10,'+1787':10,
        '+54':10,'+55':11,'+56':9,'+57':10,'+58':10,'+51':9,
