    let reservaidACancelar = null;

    function abrirModalCancelar(reserva) {
        reservaidACancelar = reserva.reservaid;

        const montoOriginal = reserva.preciofinal ?? 0;
        const infoEl = document.getElementById('cancelarInfoReserva');
        const nombre = reserva.cliente ? `${reserva.cliente.nombre ?? ''} ${reserva.cliente.apellido ?? ''}`.trim() : `Reserva #${reserva.reservaid}`;
        const fi = new Date(reserva.fecha_inicio).toLocaleDateString('es-SV');
        const ff = new Date(reserva.fecha_fin).toLocaleDateString('es-SV');

        infoEl.innerHTML = `
            <div style="font-weight:700;color:#C0392B;margin-bottom:6px;"><i class="bi bi-exclamation-triangle-fill me-1"></i>¿Cancelar esta reserva?</div>
            <div><strong>Huésped:</strong> ${nombre}</div>
            <div><strong>Fechas:</strong> ${fi} → ${ff}</div>
            <div><strong>Total pagado:</strong> $${Number(montoOriginal).toFixed(2)}</div>
        `;

        // Sincronizar slider e input
        const slider = document.getElementById('cancelarPorcentajeSlider');
        const input = document.getElementById('cancelarPorcentajeInput');
        if (slider) slider.value = 100;
        if (input) input.value = 100;
        actualizarMontoReembolso(montoOriginal, 100);

        const alerta = document.getElementById('cancelarAlertaError');
        if (alerta) alerta.style.display = 'none';

        // Eventos slider ↔ input
        const onSliderChange = () => {
            const pct = parseInt(slider.value) || 0;
            input.value = pct;
            actualizarMontoReembolso(montoOriginal, pct);
        };
        const onInputChange = () => {
            let pct = parseInt(input.value) || 0;
            if (pct < 0) pct = 0;
            if (pct > 100) pct = 100;
            input.value = pct;
            slider.value = pct;
            actualizarMontoReembolso(montoOriginal, pct);
        };

        // Limpiar listeners previos clonando
        const nuevoSlider = slider.cloneNode(true);
        slider.parentNode.replaceChild(nuevoSlider, slider);
        const nuevoInput = input.cloneNode(true);
        input.parentNode.replaceChild(nuevoInput, input);
        nuevoSlider.addEventListener('input', () => {
            nuevoInput.value = nuevoSlider.value;
            actualizarMontoReembolso(montoOriginal, parseInt(nuevoSlider.value) || 0);
        });
        nuevoInput.addEventListener('input', () => {
            let pct = parseInt(nuevoInput.value) || 0;
            if (pct < 0) pct = 0;
            if (pct > 100) pct = 100;
            nuevoInput.value = pct;
            nuevoSlider.value = pct;
            actualizarMontoReembolso(montoOriginal, pct);
        });

        const modal = new bootstrap.Modal(document.getElementById('modalCancelarReserva'));
        modal.show();
    }

    function actualizarMontoReembolso(montoOriginal, porcentaje) {
        const monto = (montoOriginal * porcentaje / 100).toFixed(2);
        const el = document.getElementById('cancelarMontoReembolso');
        if (el) {
            if (porcentaje === 0) {
                el.innerHTML = `<i class="bi bi-slash-circle" style="color:#E74C3C"></i> Sin reembolso`;
                el.style.color = '#E74C3C';
            } else {
                el.innerHTML = `<i class="bi bi-check-circle-fill"></i> Se reembolsarán: <strong>$${monto}</strong>`;
                el.style.color = '#1A8C6E';
            }
        }
    }

