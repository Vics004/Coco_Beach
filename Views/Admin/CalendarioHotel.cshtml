    function calcularPrecioEditar() {
        const fi = document.getElementById('editFechaInicio')?.value;
        const ff = document.getElementById('editFechaFin')?.value;
        const recursoid = document.getElementById('editRecursoid')?.value;
        const infoEl = document.getElementById('editPrecioInfo');
        const infoTexto = document.getElementById('editPrecioInfoTexto');
        const precioInput = document.getElementById('editPrecio');

        if (!fi || !ff || !recursoid) { if(infoEl) infoEl.style.display = 'none'; return; }
        const inicio = new Date(fi);
        const fin = new Date(ff);
        const dias = Math.round((fin - inicio) / (1000 * 60 * 60 * 24));
        if (dias <= 0) { if(infoEl) infoEl.style.display = 'none'; return; }

        const precioPorNoche = getPrecioRecurso(recursoid);
        const total = dias * precioPorNoche;
        if(infoTexto) infoTexto.textContent = `${dias} ${dias === 1 ? 'día' : 'días'} × $${precioPorNoche.toFixed(2)}/noche = $${total.toFixed(2)}`;
        if(infoEl) infoEl.style.display = 'flex';

        if (precioInput && !precioInput.dataset.editadoManual) {
            precioInput.value = total.toFixed(2);
        }
    }

