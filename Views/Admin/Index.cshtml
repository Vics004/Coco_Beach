@model IEnumerable<persona>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Incluir Bootstrap Icons si no está en el layout -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container-fluid mt-4">

    <!-- Views/Shared/_AdminCardHeader.cshtml -->
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-header text-white p-4"
             style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <i class="bi bi-shield-lock-fill me-3" style="font-size: 3.2rem; opacity: 0.9;"></i>
                    <div>
                        <h2 class="mb-1 fw-bold">@ViewData["Title"]</h2>
                        <p class="mb-0 text-white-75 small">Gestión de seguridad y accesos del sistema</p>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-arrow-left-circle"></i> Volver al panel
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0 text-dark fw-semibold">
                    <i class="bi bi-people-fill text-primary me-2"></i>
                    Usuarios del Sistema
                </h4>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-plus-lg"></i> Nuevo Usuario
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Teléfono</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.nombre @item.apellido</td>
                                <td>@item.correo</td>
                                <td>
                                    @if (item.rolid.HasValue)
                                    {
                                        <span class="badge bg-info-subtle text-info px-3 py-2">
                                            @item.rol?.nombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Sin rol</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">@item.estado</span>
                                </td>
                                <td>@item.telefono</td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.personaid" class="btn btn-outline-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.personaid" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center mt-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    No hay usuarios registrados en el sistema todavía.
                </div>
            }
        </div>
    </div>
</div>