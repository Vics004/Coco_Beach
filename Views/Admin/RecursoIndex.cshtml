@model IEnumerable<Coco_Beach.Models.recurso>

@{
    ViewData["Title"] = "Gestión de Recursos";
    Layout = "~/Views/Shared/_Layout_Administrador.cshtml";
}

<div class="container-fluid">

    <!-- Cabecera de página -->
    <div class="cb-page-header">
        <div class="d-flex align-items-center">
            <i class="bi bi-door-closed-fill cb-page-header-icon"></i>
            <div>
                <h2>@ViewData["Title"]</h2>
                <p>Administra las habitaciones, suites y espacios del hotel</p>
            </div>
        </div>
        <a asp-action="RecursoCreate" class="cb-btn cb-btn-header">
            <i class="bi bi-plus-lg"></i> Nuevo Recurso
        </a>
    </div>

    <!-- Mensaje de éxito -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cb-alert cb-alert-info mb-4">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        </div>
    }

    <!-- Tabla de recursos -->
    <div class="cb-card">
        <div class="cb-card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 style="font-family:var(--font-heading); font-weight:700; color:var(--cb-text-main); margin:0;">
                    Listado de Espacios
                </h5>
            </div>

            <div class="table-responsive">
                <table class="table cb-table mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Capacidad</th>
                            <th>Precio / Noche</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="fw-semibold">@item.recursoid</span></td>
                                <td><span style="font-weight:600; color:var(--cb-text-main);">@item.nombre</span></td>
                                <td><span class="badge bg-secondary">@item.capacidad personas</span></td>
                                <td><span style="font-weight:600; color:var(--cb-primary);">$@item.precio?.ToString("N0")</span></td>
                                <td>
                                    @if (item.libre == true)
                                    {
                                        <span class="cb-badge cb-badge-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="cb-badge cb-badge-danger">Ocupada</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="RecursoEdit" asp-route-id="@item.recursoid" class="cb-btn cb-btn-warning btn-sm me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="RecursoDelete" asp-route-id="@item.recursoid" class="cb-btn cb-btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="cb-alert cb-alert-info mt-4">
                    <i class="bi bi-info-circle-fill"></i>
                    No hay espacios registradas en el sistema. ¡Comienza agregando una!
                </div>
            }

        </div>
    </div>

</div>

<style>
    .cb-btn-header {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
        padding: 0.6rem 1.2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
        position: relative;
        z-index: 10;
    }

        .cb-btn-header:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.6);
            transform: translateY(-1px);
            color: #fff;
            text-decoration: none;
        }

        .cb-btn-header:active {
            transform: translateY(0);
        }

        .cb-btn-header i {
            pointer-events: none;
        }
</style>
