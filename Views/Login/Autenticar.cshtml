@{
    Layout = "_Layout_Login";
    ViewData["Title"] = "Iniciar Sesión - CocoBeach";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700;800&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">

<style>
    :root {
        --cb-primary: #29B6D2;
        --cb-primary-dark: #1A8FA8;
        --cb-primary-pale: #E3F6FA;
        --cb-accent: #F5A623;
        --cb-text-main: #1A2E35;
        --cb-text-muted: #6B8C99;
        --cb-border: #C9E8F0;
        --cb-danger: #E05C6B;
        --font-heading: 'Raleway', sans-serif;
        --font-body: 'Lato', sans-serif;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: var(--font-body);
        min-height: 100vh;
        background: linear-gradient(160deg, #0D2F3F 0%, #1A5F7A 50%, #29B6D2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

    .bg-bubble {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        pointer-events: none;
    }

        .bg-bubble:nth-child(1) {
            width: 400px;
            height: 400px;
            top: -100px;
            right: -100px;
        }

        .bg-bubble:nth-child(2) {
            width: 250px;
            height: 250px;
            bottom: -60px;
            left: -60px;
        }

        .bg-bubble:nth-child(3) {
            width: 150px;
            height: 150px;
            bottom: 30%;
            right: 10%;
            background: rgba(255,255,255,0.03);
        }

    .login-wrapper {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 440px;
        padding: 20px;
        margin: 0 auto;
    }

    .login-brand1 {
        text-align: center;
        margin-bottom: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 36px 40px 32px;
        width: 100%;
        box-shadow: 0 24px 60px rgba(0,0,0,0.25);
        position: relative;
        overflow: hidden;
    }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--cb-primary), var(--cb-accent));
        }

    .login-card-title {
        font-family: var(--font-heading);
        font-size: 20px;
        font-weight: 700;
        color: var(--cb-text-main);
        margin-bottom: 4px;
    }

    .login-card-sub {
        font-size: 13px;
        color: var(--cb-text-muted);
        margin-bottom: 28px;
    }

    .cb-field {
        margin-bottom: 20px;
    }

    .cb-label {
        font-family: var(--font-heading);
        font-size: 13px;
        font-weight: 600;
        color: var(--cb-text-main);
        display: block;
        margin-bottom: 7px;
    }

    .cb-input-wrap {
        position: relative;
    }

    .cb-input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--cb-text-muted);
        font-size: 16px;
        pointer-events: none;
    }

    /* ── Botón de mostrar/ocultar contraseña ── */
    .cb-toggle-pass {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        color: var(--cb-text-muted);
        font-size: 16px;
        line-height: 1;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }

        .cb-toggle-pass:hover {
            color: var(--cb-primary);
        }

    .cb-form-control {
        width: 100%;
        border: 1.5px solid var(--cb-border);
        border-radius: 10px;
        padding: 11px 14px 11px 40px;
        font-size: 14px;
        font-family: var(--font-body);
        color: var(--cb-text-main);
        background: #FAFEFF;
        transition: border-color 0.2s, box-shadow 0.2s;
        outline: none;
    }
        /* Padding derecho extra cuando hay botón de toggle */
        .cb-form-control.has-toggle {
            padding-right: 42px;
        }

        .cb-form-control:focus {
            border-color: var(--cb-primary);
            box-shadow: 0 0 0 3px rgba(41,182,210,0.15);
            background: #FFFFFF;
        }

        .cb-form-control::placeholder {
            color: #B5CDD4;
        }

    .cb-btn-login {
        width: 100%;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--cb-primary) 0%, var(--cb-primary-dark) 100%);
        color: #fff;
        font-family: var(--font-heading);
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 8px;
        letter-spacing: 0.3px;
    }

        .cb-btn-login:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(41,182,210,0.40);
        }

        .cb-btn-login:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

    /* ── Mensaje de error ── */
    .cb-error {
        background: #FCE8EA;
        color: #8B2030;
        border-left: 4px solid var(--cb-danger);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        margin-top: 20px;
    }

        .cb-error i {
            margin-top: 1px;
            flex-shrink: 0;
        }

    /* ── Countdown timer cuando está bloqueado ── */
    .cb-countdown {
        font-weight: 700;
        font-size: 13px;
        margin-top: 6px;
        color: var(--cb-danger);
        display: block;
    }

    /* ── Advertencia de intentos restantes ── */
    .cb-warn {
        background: #FFF4E0;
        color: #7A4B00;
        border-left: 4px solid var(--cb-accent);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
    }

    .login-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 12px;
        color: rgba(255,255,255,0.40);
    }

    /* Ocultar el botón nativo de revelar contraseña del navegador */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear,
    input[type="password"]::-webkit-contacts-auto-fill-button,
    input[type="password"]::-webkit-credentials-auto-fill-button {
        display: none !important;
        visibility: hidden;
        pointer-events: none;
    }
</style>

<div class="bg-bubble"></div>
<div class="bg-bubble"></div>
<div class="bg-bubble"></div>

<div class="login-wrapper">

    <div class="login-brand1">
        <img src="~/images/logo2 grupo morales texto completo.png"
             alt="CocoBeach - Hotel & Rancho"
             style="max-width:150px; width:100%; height:auto;
                    filter:brightness(0) invert(1);
                    drop-shadow(0 4px 12px rgba(0,0,0,0.3));" />
    </div>

    <div class="login-card">
        <div class="login-card-title">Bienvenido de vuelta</div>

        @{
            bool bloqueado = ViewData["EstaBlockeado"] as bool? == true;
        }

        <form method="post">

            <div class="cb-field">
                <label class="cb-label" for="txtUsuario">Correo Electrónico</label>
                <div class="cb-input-wrap">
                    <i class="bi bi-envelope cb-input-icon"></i>
                    @if (bloqueado)
                    {
                        @Html.TextBox("txtUsuario", "", new
                            {
                                @class = "cb-form-control",
                                placeholder = "ejemplo@correo.com",
                                type = "email",
                                id = "txtUsuario",
                                disabled = "disabled"
                            })
                    }
                    else
                    {
                        @Html.TextBox("txtUsuario", "", new
                            {
                                @class = "cb-form-control",
                                placeholder = "ejemplo@correo.com",
                                type = "email",
                                required = "required",
                                id = "txtUsuario"
                            })
                    }
                </div>
            </div>

            <div class="cb-field">
                <label class="cb-label" for="txtClave">Contraseña</label>
                <div class="cb-input-wrap">
                    <i class="bi bi-lock cb-input-icon"></i>
                    @if (bloqueado)
                    {
                        @Html.Password("txtClave", "", new
                            {
                                @class = "cb-form-control has-toggle",
                                placeholder = "••••••••••",
                                id = "txtClave",
                                disabled = "disabled"
                            })
                    }
                    else
                    {
                        @Html.Password("txtClave", "", new
                            {
                                @class = "cb-form-control has-toggle",
                                placeholder = "••••••••••",
                                required = "required",
                                id = "txtClave"
                            })
                    }
                    <button type="button"
                            class="cb-toggle-pass"
                            id="btnTogglePass"
                            aria-label="Mostrar/ocultar contraseña"
                            tabindex="-1">
                        <i class="bi bi-eye" id="iconoOjo"></i>
                    </button>
                </div>
            </div>

            @if (bloqueado)
            {
                <button type="submit" class="cb-btn-login" disabled>
                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar Sesión
                </button>
            }
            else
            {
                <button type="submit" class="cb-btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Iniciar Sesión
                </button>
            }
        </form>

        @{
            var errorMsg = ViewData["ErrorMessage"]?.ToString();
        }

        @if (!string.IsNullOrEmpty(errorMsg))
        {
            if (bloqueado)
            {
                <!-- Error de bloqueo con cuenta regresiva -->
                <div class="cb-error" id="bloqueadoMsg" data-desbloquea="@ViewData["DesbloqueaEn"]">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div>
                        <div>@errorMsg</div>
                        <span class="cb-countdown" id="countdownTimer"></span>
                    </div>
                </div>
            }
            else
            {
                <!-- Error de credenciales con advertencia de intentos -->
                <div class="cb-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @errorMsg
                </div>
            }
        }
    </div>

    <div class="login-footer">
        © @DateTime.Now.Year CocoBeach — Sistema de Gestión
    </div>
</div>

<script>

    (function () {
        const btn   = document.getElementById('btnTogglePass');
        const input = document.getElementById('txtClave');
        const icon  = document.getElementById('iconoOjo');

        if (!btn || !input) return;

        btn.addEventListener('click', function () {
            const esPassword = input.type === 'password';
            input.type       = esPassword ? 'text' : 'password';
            icon.className   = esPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
        });
    })();


    (function () {
        const el = document.getElementById('countdownTimer');
        const div = document.getElementById('bloqueadoMsg');
        if (!el || !div) return;

        // Leer el timestamp exacto desde el servidor (milisegundos UTC)
        const desbloqueaEn = parseInt(div.getAttribute('data-desbloquea'), 10);
        if (!desbloqueaEn || isNaN(desbloqueaEn)) return;

        function actualizar() {
            const ahora = Date.now();
            const restante = desbloqueaEn - ahora;

            if (restante <= 0) {
                el.textContent = 'Tiempo cumplido. Redirigiendo...';
                el.style.color = '#1A8FA8';
                setTimeout(function () {
                    window.location.href = window.location.pathname;
                }, 1500);
                return;
            }

            const totalSeg = Math.ceil(restante / 1000);
            const m = Math.floor(totalSeg / 60);
            const s = totalSeg % 60;
            el.textContent = `Tiempo restante: ${m}m ${String(s).padStart(2, '0')}s`;

            setTimeout(actualizar, 1000);
        }

        actualizar();
    })();
</script>