@{
    Layout = "_Layout_Login";
    ViewData["Title"] = "Iniciar Sesión - Coco Beach";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="text-center">

        <h1 style="color: #ffd700; font-weight: bold; font-size: 4rem; text-shadow: 2px 2px 4px rgba(0,0,0,0.3);" class="mb-5">
            🏖️ Coco Beach
        </h1>

        <div class="w-100" style="max-width: 500px;">
            <div class="p-4 border rounded shadow-lg" style="border-color: #87CEEB; background-color: rgba(255, 255, 255, 0.95);">
                <h3 class="mb-4" style="color: #2c3e50;">Iniciar Sesión</h3>
                <h5 class="mb-4" style="color: #666;">Personal autorizado</h5>

                <form method="post" class="mt-2">
                    <div class="form-group text-start">
                        <label for="txtUsuario" class="d-block fw-bold" style="color: #2c3e50;">
                            <i class="bi bi-envelope"></i> Correo Electrónico
                        </label>
                        @Html.TextBox("txtUsuario", "", new
                            {
                                @class = "form-control form-control-lg",
                                style = "border-color: #87CEEB;",
                                placeholder = "ejemplo@correo.com",
                                type = "email",
                                required = "required"
                            })
                    </div>

                    <div class="form-group mt-4 text-start">
                        <label for="txtClave" class="d-block fw-bold" style="color: #2c3e50;">
                            <i class="bi bi-lock"></i> Contraseña
                        </label>
                        @Html.Password("txtClave", "", new
                            {
                                @class = "form-control form-control-lg",
                                style = "border-color: #87CEEB;",
                                placeholder = "**********",
                                required = "required"
                            })
                    </div>

                    <button type="submit"
                            class="btn btn-lg mt-4"
                            style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; width: 100%; border: none; font-weight: bold;">
                        <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
                    </button>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewData["ErrorMessage"]?.ToString()))
        {
            <div class="alert alert-danger mt-4 shadow-lg" role="alert" style="max-width: 500px; margin: 0 auto;">
                <i class="bi bi-exclamation-triangle-fill"></i>
                @ViewData["ErrorMessage"]
            </div>
        }
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
