@{
    Layout = ViewBag.Layout;
    ViewData["Title"] = "Panel Principal - Coco Beach";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-person-circle text-white" style="font-size: 4rem;"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h2 class="text-white mb-1">¡Bienvenido, @ViewBag.nombre @ViewBag.apellido!</h2>
                            <p class="text-white-50 mb-0">
                                <i class="bi bi-briefcase-fill"></i>
                                <span class="badge bg-warning text-dark p-2">@ViewBag.rol</span>
                            </p>
                        </div>
                        <div>
                            <a href="@Url.Action("Logout", "Login")" class="btn btn-light">
                                <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Aquí irá el contenido específico de cada rol -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4>Panel de Control</h4>
                    <p>Bienvenido al sistema de gestión de Coco Beach. Selecciona una opción del menú para comenzar.</p>

                    @switch (ViewBag.rol)
                    {
                        case "Administrador":
							Layout = "~/Views/Shared/_Layout_Administrador.cshtml";
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Tienes acceso completo al sistema.
                            </div>
                            break;
                        case "Dueño":
							Layout = "~/Views/Shared/_Layout_Dueño.cshtml";
                            <div class="alert alert-success">
                                <i class="bi bi-graph-up"></i> Puedes ver reportes y estadísticas.
                            </div>
                            break;
                        case "Gerente de Hotel":
							Layout = "~/Views/Shared/_Layout_GerenteHotel.cshtml";
                            <div class="alert alert-primary">
                                <i class="bi bi-building"></i> Gestión de habitaciones y reservas.
                            </div>
                            break;
                        case "Gerente de Rancho":
							Layout = "~/Views/Shared/_Layout_GerenteRancho.cshtml";
                            <div class="alert alert-warning">
                                <i class="bi bi-tree"></i> Gestión de cabañas y actividades.
                            </div>
                            break;
                        case "Encargado":
							Layout = "~/Views/Shared/_Layout_Encargado.cshtml";
                            <div class="alert alert-secondary">
                                <i class="bi bi-clipboard-check"></i> Gestión de check-ins y check-outs.
                            </div>
                            break;
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
