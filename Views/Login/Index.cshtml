@{
    Layout = ViewBag.Layout;
    ViewData["Title"] = "Panel Principal - Coco Beach";
}

<!-- Este contenido irá dentro de .cb-content (el Layout ya lo provee) -->
<div>
    <!-- CABECERA DE PÁGINA con gradiente celeste tropical -->
    <div class="cb-page-header">
        <div class="d-flex align-items-center">
            <i class="bi bi-person-circle cb-page-header-icon"></i>
            <div>
                <h2>¡Bienvenido, @ViewBag.nombre @ViewBag.apellido!</h2>
                <p>
                    <i class="bi bi-briefcase-fill me-1"></i>
                    <span class="cb-badge cb-badge-info">@ViewBag.rol</span>
                </p>
            </div>
        </div>
    </div>

    <!-- PANEL DE CONTROL (tarjeta principal) -->
    <div class="cb-card">
        <div class="cb-card-body">
            <h4>Panel de Control</h4>
            <p>Bienvenido al sistema de gestión de Coco Beach. Selecciona una opción del menú para comenzar.</p>

            @switch (ViewBag.rol)
            {
                case "Administrador":
                    <div class="cb-alert cb-alert-info mt-3">
                        <i class="bi bi-info-circle-fill"></i> Tienes acceso completo al sistema.
                    </div>
                    break;
                case "Dueño":
                    <div class="cb-alert cb-alert-info mt-3">
                        <i class="bi bi-graph-up"></i> Puedes ver reportes y estadísticas.
                    </div>
                    break;
                case "Gerente de Hotel":
                    <div class="cb-alert cb-alert-info mt-3">
                        <i class="bi bi-building"></i> Gestión de habitaciones y reservas.
                    </div>
                    break;
                case "Gerente de Rancho":
                    <div class="cb-alert cb-alert-info mt-3">
                        <i class="bi bi-tree"></i> Gestión de cabañas y actividades.
                    </div>
                    break;
                case "Encargado":
                    <div class="cb-alert cb-alert-info mt-3">
                        <i class="bi bi-clipboard-check"></i> Gestión de check-ins y check-outs.
                    </div>
                    break;
            }
        </div>
    </div>
</div>

<!-- Bootstrap Igons (ya deberían estar en el Layout, pero se mantienen por si acaso) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">